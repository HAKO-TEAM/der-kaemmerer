---
// Verzeichnis der Haushaltssperren: Karte und Liste aller von der Redaktion belegten Fälle seit 2025, mit Quellen.
// Datenbasis src/data/haushaltslage/sperren.json (wird von der Artikel-Routine gepflegt); Karte als SVG ohne externe Kartendienste.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import sperren from '../data/haushaltslage/sperren.json';
import gemeinden from '../data/spiegel/gemeinden.json';
import { LAND_LANG, LAND_SLUG, imLand } from '../lib/gemeinden.mjs';
import { kommunenMitSperre, raster, projiziere, KARTE } from '../lib/sperren-karte.mjs';

const kommunen = kommunenMitSperre(sperren as any, gemeinden as any[]);
const hintergrund = raster(gemeinden as any[]);
const stand = new Date((sperren as any).stand).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
const laender = Object.entries(kommunen.reduce((m: any, k) => ((m[k.land] ||= []).push(k), m), {}))
  .map(([l, ks]: any) => ({ l, name: LAND_LANG[l], ks })).sort((a, b) => b.ks.length - a.ks.length || a.name.localeCompare(b.name, 'de'));
const anzahlKreise = kommunen.filter((k) => k.ebene === 'kreis').length;
const id = (k: any) => `fall-${k.land}-${k.name}`.toLowerCase().replace(/[^a-z0-9äöüß]+/g, '-');
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return 'Quelle'; } };
const punkte = kommunen.filter((k) => k.lat != null).map((k) => ({ ...k, ...projiziere(k.lat, k.lon) }));
const ld = { '@context': 'https://schema.org', '@type': 'Dataset', name: 'Haushaltssperren deutscher Kommunen seit 2025',
  description: `Von der Redaktion Der Kämmerer belegte Haushaltssperren in ${kommunen.length} Kommunen, jeweils mit Quelle. Stand ${stand}.`,
  url: 'https://derkaemmerer.de/haushaltssperren/', creator: { '@type': 'Organization', name: 'Der Kämmerer' }, dateModified: (sperren as any).stand,
  spatialCoverage: 'Deutschland', isAccessibleForFree: true };
---
<Base title={`Haushaltssperren 2026: Karte und Liste aller ${kommunen.length} Kommunen`}
  description={`Welche Städte, Gemeinden und Kreise haben eine Haushaltssperre? Karte und Liste aller ${kommunen.length} von der Redaktion belegten Fälle seit 2025 – mit Datum, Umfang, Anlass und Quelle. Stand ${stand}.`}>
<Header />
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<style>
.hs { color:#0f172a; } .hs-w { max-width:1080px; margin:0 auto; padding:0 28px; }
.hs-kopf { background:#172840; color:#fff; padding:40px 0 36px; border-bottom:3px solid #dc2626; }
.hs-k { font-size:11px; font-weight:700; letter-spacing:.2em; text-transform:uppercase; color:#fca5a5; }
.hs-kopf h1 { font-family:'Playfair Display',Georgia,serif; font-size:clamp(28px,4.2vw,46px); line-height:1.1; margin:10px 0 12px; max-width:24ch; }
.hs-kopf p { color:rgba(255,255,255,.75); font-size:17px; max-width:66ch; line-height:1.55; margin:0; }
.hs-zahlen { display:flex; flex-wrap:wrap; gap:28px; margin-top:22px; } .hs-zahlen b { display:block; font-size:30px; font-family:'Playfair Display',Georgia,serif; } .hs-zahlen span { font-size:13px; color:rgba(255,255,255,.6); }
.hs-haupt { display:grid; grid-template-columns:400px 1fr; gap:34px; padding:34px 0 10px; align-items:start; }
.hs-karte { position:sticky; top:16px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:14px; }
.hs-karte svg { width:100%; height:auto; display:block; }
.hs-karte .bg { fill:#cbd5e1; }
.hs-karte a circle { fill:#dc2626; stroke:#fff; stroke-width:1.5; opacity:.9; transition:r .15s; } .hs-karte a:hover circle { r:9; opacity:1; }
.hs-karte a circle.kreis { fill:#f97316; }
.hs-leg { display:flex; gap:16px; font-size:12px; color:#475569; margin-top:8px; } .hs-leg i { display:inline-block; width:10px; height:10px; border-radius:50%; background:#dc2626; margin-right:5px; vertical-align:-1px; } .hs-leg i.k { background:#f97316; }
.hs-land { margin-bottom:26px; } .hs-land h2 { font-family:'Playfair Display',Georgia,serif; font-size:22px; margin:0 0 10px; padding-bottom:6px; border-bottom:2px solid #172840; display:flex; justify-content:space-between; align-items:baseline; }
.hs-land h2 small { font-family:Arial,sans-serif; font-size:13px; color:#64748b; font-weight:400; }
.hs-fall { padding:12px 0; border-bottom:1px solid #f1f5f9; scroll-margin-top:20px; } .hs-fall:target { background:#fef2f2; }
.hs-fall h3 { margin:0 0 4px; font-size:16px; } .hs-fall h3 a { color:#0f172a; text-decoration:none; } .hs-fall h3 a:hover { color:#2563eb; }
.hs-fall h3 em { font-style:normal; font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:#c2410c; background:#ffedd5; border-radius:4px; padding:2px 6px; margin-left:6px; vertical-align:2px; }
.hs-fall p { margin:3px 0; font-size:14px; color:#334155; line-height:1.5; } .hs-fall p b { color:#0f172a; }
.hs-q { font-size:12px; } .hs-q a { color:#2563eb; margin-right:10px; }
.hs-text { padding:10px 0 50px; max-width:72ch; color:#475569; font-size:15px; line-height:1.65; } .hs-text h2 { font-family:'Playfair Display',Georgia,serif; color:#0f172a; font-size:22px; } .hs-text a { color:#2563eb; }
@media (max-width:900px){ .hs-w{padding:0 16px} .hs-haupt{grid-template-columns:1fr} .hs-karte{position:static; max-width:420px; margin:0 auto} }
</style>

<div class="hs">
  <section class="hs-kopf"><div class="hs-w">
    <div class="hs-k">Der Kämmerer · Verzeichnis der Haushaltssperren</div>
    <h1>Haushaltssperren in Deutschland: alle belegten Fälle</h1>
    <p>Welche Städte, Gemeinden und Kreise haben eine Haushaltssperre verhängt? Die Redaktion führt jeden Fall mit Datum, Umfang, Anlass und Quelle. Stand {stand}.</p>
    <div class="hs-zahlen">
      <div><b>{kommunen.length}</b><span>Kommunen seit 2025</span></div>
      <div><b>{kommunen.length - anzahlKreise}</b><span>Städte und Gemeinden</span></div>
      <div><b>{anzahlKreise}</b><span>Kreise</span></div>
      <div><b>{laender.length}</b><span>Bundesländer</span></div>
    </div>
  </div></section>

  <div class="hs-w">
    <div class="hs-haupt">
      <div class="hs-karte">
        <svg viewBox={`0 0 ${KARTE.breite} ${KARTE.hoehe}`} role="img" aria-label="Karte Deutschlands mit allen belegten Haushaltssperren">
          <path class="bg" d={hintergrund} />
          {punkte.map((k) => <a href={`#${id(k)}`}><circle class={k.ebene === 'kreis' ? 'kreis' : ''} cx={k.x + 2} cy={k.y + 2} r="6"><title>{k.name}{k.faelle.length > 1 ? ` (${k.faelle.length} Sperren)` : ''}</title></circle></a>)}
        </svg>
        <div class="hs-leg"><span><i></i>Stadt / Gemeinde</span><span><i class="k"></i>Kreis</span></div>
      </div>

      <div>
        {laender.map((l) => (
          <section class="hs-land">
            <h2>{l.name}<small>{l.ks.length} {l.ks.length === 1 ? 'Kommune' : 'Kommunen'}</small></h2>
            {l.ks.map((k: any) => (
              <article class="hs-fall" id={id(k)}>
                <h3>{k.url ? <a href={k.url}>{k.name}</a> : k.name}{k.ebene === 'kreis' && <em>Kreis</em>}</h3>
                {k.faelle.map((f: any) => (<>
                  <p><b>Sperre:</b> {f.art}</p>
                  {f.anlass && <p><b>Anlass:</b> {f.anlass}</p>}
                  <p class="hs-q">{(f.quellen || []).map((q: string) => <a href={q} target="_blank" rel="noopener nofollow">{host(q)} ↗</a>)}{f.artikel && <a href={f.artikel}>Einordnung der Redaktion</a>}</p>
                </>))}
              </article>
            ))}
          </section>
        ))}
      </div>
    </div>

    <section class="hs-text">
      <h2>Was eine Haushaltssperre bedeutet</h2>
      <p>Mit einer Haushaltssperre stoppt die Kämmerin oder der Kämmerer – je nach Landesrecht auch die Verwaltungsspitze oder die Kommunalaufsicht – die Inanspruchnahme bereits beschlossener Ansätze, wenn sich ein Fehlbetrag abzeichnet. Ausgaben, zu denen die Kommune rechtlich verpflichtet ist, laufen weiter; gesperrt werden freiwillige Leistungen, neue Aufträge und oft auch Stellenbesetzungen. Grundlage sind die Gemeindehaushaltsverordnungen der Länder, etwa § 25 KomHVO in Nordrhein-Westfalen oder § 29 GemHVO in Baden-Württemberg.</p>
      <p>Hintergründe, Rechtsgrundlagen und Folgen: <a href="/haushalt/haushaltssperre-2026-stadte/">Haushaltssperre 2026 – Liste, Rechtsgrundlagen, Folgen</a>. Hebesätze und Verschuldung jeder Kommune im Vergleich zeigt das <a href="/gemeinden/">Gemeindeverzeichnis</a>.</p>
      <p>Ein Fall fehlt oder hat sich geändert? Hinweise mit Quelle an <a href="mailto:chefredaktion@derkaemmerer.de?subject=Haushaltssperre%20%E2%80%93%20Hinweis">chefredaktion@derkaemmerer.de</a>.</p>
    </section>
  </div>
</div>
<Footer />
</Base>
