---
// Haushaltslage der Kommunen: Ländervergleich (Kassenkredite, Schulden, Haushaltssperren) mit Links auf die Länderseiten.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import gemeinden from '../../data/spiegel/gemeinden.json';
import schulden from '../../data/spiegel/schulden.json';
import sperren from '../../data/haushaltslage/sperren.json';
import { LAND_LANG, LAND_SLUG } from '../../lib/gemeinden.mjs';
import { gewichtet } from '../../lib/kreise.mjs';
import { kommunenMitSperre } from '../../lib/sperren-karte.mjs';

const S = schulden as any;
const sp = kommunenMitSperre(sperren as any, gemeinden as any[]);
const zeilen = Object.keys(LAND_LANG).filter((l) => !['BE', 'HH', 'HB'].includes(l)).map((l) => {
  const gs = (gemeinden as any[]).filter((g) => g.land === l);
  return { l, name: (LAND_LANG as any)[l], n: gs.length, kk: gewichtet(gs, (g) => S[g.ags]?.kassenkredite_je_ew ?? null) || 0, sch: gewichtet(gs, (g) => S[g.ags]?.schulden_je_ew ?? null) || 0,
    hoch: gs.filter((g) => (S[g.ags]?.kassenkredite_je_ew || 0) >= 1000).length, sperren: sp.filter((k: any) => k.land === l).length };
}).sort((a, b) => b.kk - a.kk);
const max = zeilen[0].kk;
const z = (x: number, e = '') => Math.round(x).toLocaleString('de-DE') + e;
---
<Base title="Haushaltslage der Kommunen 2026: Kassenkredite, Schulden und Haushaltssperren je Bundesland"
  description="Wie stehen die Kommunen in jedem Bundesland da? Kassenkredite und Schulden je Einwohner, Gemeinden mit hohen Liquiditätskrediten und belegte Haushaltssperren – mit Karte für jedes Land.">
<Header />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<style>
.hi { max-width:1040px; margin:0 auto; padding:36px 28px 60px; color:#0f172a; }
.hi h1 { font-family:'Playfair Display',Georgia,serif; font-size:clamp(28px,4.2vw,46px); margin:8px 0 10px; line-height:1.1; }
.hi > p { color:#475569; font-size:16.5px; line-height:1.6; max-width:68ch; }
.hi-tab { width:100%; border-collapse:collapse; font-size:15px; font-variant-numeric:tabular-nums; min-width:700px; }
.hi-tab th { font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:#64748b; text-align:right; padding:10px 8px; border-bottom:1px solid #172840; } .hi-tab th:first-child, .hi-tab td:first-child { text-align:left; }
.hi-tab td { padding:11px 8px; border-bottom:1px solid #f1f5f9; text-align:right; } .hi-tab a { color:#0f172a; font-weight:700; text-decoration:none; } .hi-tab a:hover { color:#2563eb; }
.hi-tab td.bar { width:28%; } .hi-tab td.bar i { display:block; height:10px; border-radius:3px; background:linear-gradient(90deg,#fb923c,#b91c1c); }
.hi-scroll { overflow-x:auto; border:1px solid #e2e8f0; border-radius:14px; padding:6px 16px; background:#fff; margin-top:20px; }
.hi-hin { font-size:12px; color:#64748b; margin:12px 0 0; line-height:1.55; } .hi-hin a { color:#2563eb; }
@media (max-width:700px){ .hi{padding:26px 16px 50px} }
</style>
<div class="hi">
  <div style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#dc2626">Haushaltslage der Kommunen</div>
  <h1>Kassenkredite, Schulden und Haushaltssperren je Bundesland</h1>
  <p>Kassenkredite zeigen, wo Kommunen laufende Ausgaben dauerhaft auf Pump finanzieren. Der Vergleich der dreizehn Flächenländer – je Land mit Karte aller Gemeinden, Kreisvergleich und Haushaltssperren. Für Nordrhein-Westfalen gibt es zusätzlich die <a href="/haushaltslage-nrw/" style="color:#2563eb">amtliche Einstufung jeder Gemeinde</a>.</p>
  <div class="hi-scroll"><table class="hi-tab">
    <thead><tr><th>Land</th><th>Kassenkredite je EW</th><th></th><th>Schulden je EW</th><th>Gemeinden über 1.000 €</th><th>Haushaltssperren</th></tr></thead>
    <tbody>{zeilen.map((x) => <tr><td><a href={`/haushaltslage/${LAND_SLUG[x.l]}/`}>{x.name}</a></td><td><b>{z(x.kk, ' €')}</b></td><td class="bar"><i style={`width:${Math.max(1, x.kk / max * 100)}%`}></i></td><td>{z(x.sch, ' €')}</td><td>{x.hoch}</td><td>{x.sperren}</td></tr>)}</tbody>
  </table></div>
  <p class="hi-hin">Gemeinden ohne Kreise und Stadtstaaten, einwohnergewichtet, Stand 31.12.2025. Quelle: Statistische Ämter des Bundes und der Länder, Regionaldatenbank; Haushaltssperren: <a href="/haushaltssperren/">Verzeichnis der Redaktion</a>.</p>
</div>
<Footer />
</Base>
