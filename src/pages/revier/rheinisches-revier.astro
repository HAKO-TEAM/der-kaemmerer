<script>
  const t = document.getElementById('rr-tab') as HTMLTableElement | null;
  t?.querySelectorAll('th').forEach((th, i) => {
    let ab = true;
    th.addEventListener('click', () => {
      const rows = [...t.tBodies[0].rows];
      rows.sort((a, b) => {
        if (i < 2) return (ab ? 1 : -1) * a.cells[i].innerText.localeCompare(b.cells[i].innerText, 'de');
        const x = parseFloat(a.cells[i].dataset.v || 'NaN'), y = parseFloat(b.cells[i].dataset.v || 'NaN');
        return isNaN(x) ? 1 : isNaN(y) ? -1 : (ab ? y - x : x - y);
      });
      ab = !ab; rows.forEach((r) => t.tBodies[0].appendChild(r));
    });
  });
</script>
