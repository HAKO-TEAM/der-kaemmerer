---
// Einbettbare Datenkarte einer Gemeinde (iframe für Lokalredaktionen und Kommunen): Hebesätze, Schulden, Haushaltslage.
export const prerender = false;
import Einbettung from '../../../../layouts/Einbettung.astro';
import markt from '../../../../data/markt/markt.json';
import sperren from '../../../../data/haushaltslage/sperren.json';
import gemeinden from '../../../../data/spiegel/gemeinden.json';
import hebesaetze from '../../../../data/spiegel/hebesaetze.json';
import schulden from '../../../../data/spiegel/schulden.json';
import hsNw from '../../../../data/spiegel/haushaltsstatus_nw.json';
import { spiegel } from '../../../../lib/spiegel.mjs';
import { verzeichnis, gemeindeUrl } from '../../../../lib/gemeinden.mjs';
import { STUFEN } from '../../../../lib/haushaltsstatus.mjs';

const { ags: agsVon } = verzeichnis(gemeinden as any[]);
const p = `${Astro.params.land}/${Astro.params.gemeinde}`;
const ags = agsVon[p];
const s = ags ? spiegel(ags, { gemeinden, markt, sperren, hebesaetze, schulden } as any) : null;
if (!s) return new Response('Nicht gefunden', { status: 404 });
Astro.response.headers.set('Cache-Control', 'public, max-age=3600');
Astro.response.headers.set('CDN-Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=604800');

const { gemeinde: g, finanzen: f, haushalt: h } = s;
const profil = `https://derkaemmerer.de${gemeindeUrl(p)}`;
const z = (x: number | null, e = '') => (x == null ? '–' : Math.round(x).toLocaleString('de-DE') + e);
const vgl = (w: number | null, land: number | null, e: string) => w == null || land == null ? '' : `Land ${z(land, e)}`;
const tendenz = (w: number | null, land: number | null) => (w == null || land == null ? '' : w > land * 1.02 ? 'hoch' : w < land * 0.98 ? 'tief' : 'mitte');
const hs = g.land === 'NW' ? (hsNw as any).gemeinden[g.ags] : null;
const stufe = hs ? (STUFEN as any)[hs.s] : null;
const kacheln = [
  { k: 'Grundsteuer B', w: z(f.grundsteuerB.wert, ' %'), u: `${f.grundsteuerB.rangLand ? `Platz ${f.grundsteuerB.rangLand.platz} von ${f.grundsteuerB.rangLand.von} · ` : ''}${vgl(f.grundsteuerB.wert, f.grundsteuerB.land, ' %')}`, t: tendenz(f.grundsteuerB.wert, f.grundsteuerB.land) },
  { k: 'Gewerbesteuer', w: z(f.gewerbesteuer.wert, ' %'), u: `${f.gewerbesteuer.rangLand ? `Platz ${f.gewerbesteuer.rangLand.platz} von ${f.gewerbesteuer.rangLand.von} · ` : ''}${vgl(f.gewerbesteuer.wert, f.gewerbesteuer.land, ' %')}`, t: tendenz(f.gewerbesteuer.wert, f.gewerbesteuer.land) },
  { k: 'Schulden je Einwohner', w: z(f.schulden.wert, ' €'), u: vgl(f.schulden.wert, f.schulden.land, ' €'), t: tendenz(f.schulden.wert, f.schulden.land) },
];
const lage = stufe ? { k: 'Haushaltsstatus NRW', w: stufe.kurz, u: '31.12.2025, amtlich', farbe: stufe.farbe }
  : h.eigeneSperre ? { k: 'Haushaltssperre', w: 'belegt', u: String(h.eigeneSperre.art || '').slice(0, 60), farbe: '#b91c1c' }
  : { k: 'Haushaltssperren im Land', w: String(h.imLand), u: `Kommunen seit 2025`, farbe: '#172840' };
---
<Einbettung title={`Haushaltsdaten ${g.name}`} kanonisch={profil}>
<style>
  .k4 { display:grid; grid-template-columns:repeat(4,1fr); }
  .k4 div { padding:14px 16px; border-right:1px solid #f1f5f9; } .k4 div:last-child { border:0; }
  .k4 span { display:block; font-size:10.5px; letter-spacing:.08em; text-transform:uppercase; color:#64748b; font-weight:700; }
  .k4 b { display:block; font:700 24px/1.15 Georgia, serif; margin:6px 0 4px; color:#172840; font-variant-numeric:tabular-nums; }
  .k4 small { display:block; font-size:11.5px; color:#64748b; line-height:1.35; }
  .k4 .hoch b::after { content:'▲'; font-size:11px; color:#b91c1c; margin-left:5px; vertical-align:3px; }
  .k4 .tief b::after { content:'▼'; font-size:11px; color:#1d4ed8; margin-left:5px; vertical-align:3px; }
  @media (max-width:520px) { .k4 { grid-template-columns:1fr 1fr; } .k4 div:nth-child(2) { border-right:0; } .k4 div:nth-child(-n+2) { border-bottom:1px solid #f1f5f9; } }
</style>
<div class="eb">
  <div class="eb-kopf">
    <div><small>Haushaltsdaten · {g.landLang}</small><h1>{g.name}</h1></div>
    <a class="eb-marke" href={profil}>Der <span>Kämmerer</span></a>
  </div>
  <div class="k4">
    {kacheln.map((x) => <div class={x.t}><span>{x.k}</span><b>{x.w}</b><small>{x.u}</small></div>)}
    <div><span>{lage.k}</span><b style={`color:${lage.farbe};font-size:${lage.w.length > 12 ? '17px' : '24px'}`}>{lage.w}</b><small>{lage.u}</small></div>
  </div>
  <div class="eb-fuss"><span>Hebesätze 2024 · Schulden 31.12.2025 · Statistische Ämter des Bundes und der Länder</span><a href={profil}>Profil {g.name} bei Der Kämmerer →</a></div>
</div>
</Einbettung>
