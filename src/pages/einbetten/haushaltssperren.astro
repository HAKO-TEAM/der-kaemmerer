---
// Einbettbare Karte „Haushaltssperren je Bundesland“ (iframe), täglich mit dem Verzeichnis aktualisiert.
import Einbettung from '../../layouts/Einbettung.astro';
import sperren from '../../data/haushaltslage/sperren.json';
import gemeinden from '../../data/spiegel/gemeinden.json';
import { LAND_LANG, LAND_SLUG } from '../../lib/gemeinden.mjs';
import { kommunenMitSperre, laenderRaster, KARTE, stufe } from '../../lib/sperren-karte.mjs';

const kommunen = kommunenMitSperre(sperren as any, gemeinden as any[]);
const flaechen = laenderRaster(gemeinden as any[]);
const stand = new Date((sperren as any).stand).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
const jeLand = Object.keys(LAND_LANG).map((l) => ({ l, name: (LAND_LANG as any)[l], slug: LAND_SLUG[l], n: kommunen.filter((k) => k.land === l).length }))
  .sort((a, b) => b.n - a.n);
const max = Math.max(...jeLand.map((x) => x.n));
const KLEIN = new Set(['BE', 'HB', 'HH']);
const VERSATZ: Record<string, [number, number]> = { BB: [6, 26], NI: [0, 10], SH: [0, -6] };
const pos = (l: string) => ({ x: flaechen[l].x + 3 + (VERSATZ[l]?.[0] || 0), y: flaechen[l].y + 3 + (VERSATZ[l]?.[1] || 0) });
const ziel = 'https://derkaemmerer.de/haushaltssperren/';
---
<Einbettung title="Haushaltssperren je Bundesland" kanonisch={ziel}>
<style>
  .hk { display:grid; grid-template-columns:1fr 1fr; gap:14px; padding:14px 16px; align-items:center; }
  .hk svg { width:100%; height:auto; max-height:360px; display:block; overflow:visible; }
  .hk a path { stroke:#fff; stroke-width:.6; } .hk a:hover path { filter:brightness(.85); }
  .s0 { fill:#e2e8f0; } .s1 { fill:#fecaca; } .s2 { fill:#fca5a5; } .s3 { fill:#f87171; } .s4 { fill:#ef4444; } .s5 { fill:#b91c1c; }
  .zahl circle { fill:#172840; stroke:#fff; stroke-width:1.5; } .zahl text { fill:#fff; font:700 9px Arial,sans-serif; text-anchor:middle; dominant-baseline:central; }
  .zahl.null circle { fill:#94a3b8; } .stadt rect { stroke:#fff; stroke-width:1.2; } .stadt text { font:700 8px Arial,sans-serif; fill:#172840; }
  .gross { font:700 40px/1 Georgia, serif; color:#b91c1c; } .gross + p { margin:4px 0 12px; font-size:13px; color:#334155; line-height:1.45; }
  .bz { display:grid; grid-template-columns:118px 1fr 24px; gap:8px; align-items:center; font-size:12px; padding:2px 0; text-decoration:none; color:#0f172a; }
  .bz i { display:block; height:8px; border-radius:2px; background:linear-gradient(90deg,#f87171,#b91c1c); } .bz b { text-align:right; font-variant-numeric:tabular-nums; }
  @media (max-width:540px) { .hk { grid-template-columns:1fr; } }
</style>
<div class="eb">
  <div class="eb-kopf"><div><small>Stand {stand}</small><h1>Haushaltssperren in Deutschland</h1></div><a class="eb-marke" href={ziel}>Der <span>Kämmerer</span></a></div>
  <div class="hk">
    <svg viewBox={`-4 -4 ${KARTE.breite + 8} ${KARTE.hoehe + 8}`} role="img" aria-label="Karte: Haushaltssperren je Bundesland">
      {jeLand.filter((x) => !KLEIN.has(x.l) && flaechen[x.l]).map((x) => <a href={`${ziel}${x.slug}/`}><path class={`s${stufe(x.n, max)}`} d={flaechen[x.l].pfad}><title>{x.name}: {x.n}</title></path></a>)}
      {jeLand.filter((x) => !KLEIN.has(x.l) && flaechen[x.l]).map((x) => <g class={`zahl ${x.n ? '' : 'null'}`}><circle cx={pos(x.l).x} cy={pos(x.l).y} r="9" /><text x={pos(x.l).x} y={pos(x.l).y}>{x.n}</text></g>)}
      {jeLand.filter((x) => KLEIN.has(x.l) && flaechen[x.l]).map((x) => <a href={`${ziel}${x.slug}/`} class="stadt"><rect class={`s${stufe(x.n, max)}`} x={flaechen[x.l].x - 4} y={flaechen[x.l].y - 4} width="15" height="15" rx="3" /><text x={flaechen[x.l].x + 14} y={flaechen[x.l].y + 6}>{x.l === 'BE' ? 'Berlin' : x.l === 'HB' ? 'Bremen' : 'Hamburg'} {x.n}</text></a>)}
    </svg>
    <div>
      <div class="gross">{kommunen.length}</div>
      <p>Kommunen mit belegter Haushaltssperre seit 2025 – jeder Fall mit Quelle im Verzeichnis.</p>
      {jeLand.filter((x) => x.n).slice(0, 8).map((x) => <a class="bz" href={`${ziel}${x.slug}/`}><span>{x.name}</span><i style={`width:${x.n / max * 100}%`}></i><b>{x.n}</b></a>)}
    </div>
  </div>
  <div class="eb-fuss"><span>Recherche der Redaktion Der Kämmerer</span><a href={ziel}>Alle Fälle mit Quellen →</a></div>
</div>
</Einbettung>
