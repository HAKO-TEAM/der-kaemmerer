---
// Lexikon Kommunalfinanzen: alle Begriffe nach Kategorie, alphabetisch.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { LEXIKON, lexikonUrl } from '../../lib/lexikon.mjs';

const kategorien = [...new Set(LEXIKON.map((e) => e.kategorie))];
const ld = { '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'Lexikon Kommunalfinanzen', url: 'https://derkaemmerer.de/lexikon/',
  hasDefinedTerm: LEXIKON.map((e) => ({ '@type': 'DefinedTerm', name: e.begriff, url: `https://derkaemmerer.de${lexikonUrl(e.slug)}` })) };
---
<Base title="Lexikon Kommunalfinanzen: Begriffe von Ausgleichsrücklage bis Kreisumlage"
  description={`${LEXIKON.length} Begriffe des kommunalen Haushaltsrechts verständlich erklärt – Haushaltssperre, Haushaltssicherungskonzept, Kassenkredite, Kreisumlage, Hebesatz und mehr, jeweils mit aktuellen Zahlen.`}>
<Header />
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<style>
.lxi { max-width:1040px; margin:0 auto; padding:36px 28px 60px; color:#0f172a; }
.lxi h1 { font-family:'Playfair Display',Georgia,serif; font-size:clamp(30px,4.2vw,46px); margin:8px 0 10px; line-height:1.08; }
.lxi > p { color:#475569; font-size:16.5px; line-height:1.6; max-width:66ch; }
.lxi-such input { width:100%; max-width:420px; padding:12px 14px; font:inherit; font-size:16px; border:1px solid #cbd5e1; border-radius:8px; margin:12px 0 4px; box-sizing:border-box; }
.lxi-kat { margin-top:28px; } .lxi-kat h2 { font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:#2563eb; margin:0 0 10px; }
.lxi-raster { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:12px; }
.lxi-raster a { display:block; border:1px solid #e2e8f0; border-radius:12px; padding:14px 16px; background:#fff; text-decoration:none; color:#0f172a; transition:border-color .15s, box-shadow .15s; }
.lxi-raster a:hover { border-color:#2563eb; box-shadow:0 12px 26px -20px rgba(37,99,235,.7); }
.lxi-raster b { font-family:'Playfair Display',Georgia,serif; font-size:18px; display:block; margin-bottom:4px; } .lxi-raster span { font-size:13.5px; color:#475569; line-height:1.5; display:block; }
@media (max-width:700px){ .lxi{padding:26px 16px 50px} }
</style>
<div class="lxi">
  <div style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2563eb">Der Kämmerer · Nachschlagen</div>
  <h1>Lexikon Kommunalfinanzen</h1>
  <p>{LEXIKON.length} Begriffe aus Haushaltsrecht, Rechnungswesen, Steuern und Sozialausgaben – kurz erklärt, mit Beispielen aus dem Landesrecht und aktuellen Zahlen aus den Datenbeständen von Der Kämmerer.</p>
  <div class="lxi-such"><input id="lxi-q" type="search" placeholder="Begriff filtern, z. B. Rücklage" aria-label="Begriff filtern"></div>
  {kategorien.map((k) => (
    <section class="lxi-kat">
      <h2>{k}</h2>
      <div class="lxi-raster">{LEXIKON.filter((e) => e.kategorie === k).sort((a, b) => a.begriff.localeCompare(b.begriff, 'de')).map((e) => <a href={lexikonUrl(e.slug)} data-s={`${e.begriff} ${e.kurz}`.toLowerCase()}><b>{e.begriff}</b><span>{e.kurz}</span></a>)}</div>
    </section>
  ))}
</div>
<script>
  const q = document.getElementById('lxi-q') as HTMLInputElement;
  q.addEventListener('input', () => {
    const s = q.value.trim().toLowerCase();
    document.querySelectorAll<HTMLAnchorElement>('.lxi-raster a').forEach((a) => { a.hidden = !!s && !a.dataset.s!.includes(s); });
    document.querySelectorAll<HTMLElement>('.lxi-kat').forEach((k) => { k.hidden = ![...k.querySelectorAll('a')].some((a) => !a.hidden); });
  });
</script>
<Footer />
</Base>
