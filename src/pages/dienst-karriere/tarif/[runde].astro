---
// Tarifrunden-Hub (Runbook 4.3). Wird nur gebaut, wenn TARIFRUNDE.aktiv = true (bis dahin keine Seite, kein Sitemap-Eintrag).
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DkKopf from '../../../components/DkKopf.astro';
import { TARIFRUNDE, forderungWirkung } from '../../../data/tarif/tarifrunde.mjs';
import { TABELLE } from '../../../lib/rechner/tvoed-rechner.mjs';
export function getStaticPaths() { return TARIFRUNDE.aktiv ? [{ params: { runde: 'tarifrunde-tvoed' } }] : []; }
const f: any = TARIFRUNDE.forderung;
const beispiele = f ? ['E5', 'E9a', 'E11', 'E13'].map((eg) => ({ eg, monat: TABELLE[eg][2], ...forderungWirkung(TABELLE[eg][2], f) })) : [];
const fmt = (d: string) => d.split('-').reverse().join('.');
---
<Base title="Tarifrunde TVöD: Termine, Forderung und was sie bringt" description="Tarifrunde TVöD für Bund und Kommunen: Zeitleiste, Verhandlungstermine, Forderung und Ergebnis – mit Rechner für das eigene Monatsplus.">
<Header />
<DkKopf aktiv="tarif" titel="Tarifrunde TVöD" text={`Geltender Abschluss bis ${fmt(TARIFRUNDE.laufzeitBis)}. Zeitleiste, Forderung und Ergebnis der nächsten Runde.`} pfad={[{ name: 'Tarif', url: '/dienst-karriere/tarif/' }]} />
<main class="dk-main">
  {TARIFRUNDE.termine.length > 0 && <section><h2>Zeitleiste</h2><ul>{TARIFRUNDE.termine.map((t: any) => <li><b>{fmt(t.datum)}</b> – {t.text}</li>)}</ul></section>}
  {f && <section><h2>Was bringt die Forderung?</h2><p>{f.prozent} % mehr, mindestens {f.mindestbetrag} € im Monat (Stufe 3, Vollzeit):</p>
    <table>{beispiele.map((b) => <tr><td>{b.eg}</td><td>{b.monat} €</td><td>+ {b.plus} €</td><td>{b.neu} €</td></tr>)}</table><p>Quelle: {f.quelle}, Stand {f.stand}</p></section>}
</main>
<Footer />
</Base>
