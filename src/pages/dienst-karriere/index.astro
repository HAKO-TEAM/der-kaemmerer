---
// Ressort-Startseite „Dienst & Karriere“ (Runbook 4.1): Bereiche, Rechner, neueste Stellen, Stellen in der Nähe (PLZ, clientseitig)
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DkKopf from '../../components/DkKopf.astro';
import DkNewsletter from '../../components/DkNewsletter.astro';
import { RESSORT, BEREICHE, RECHNER } from '../../data/dienst-karriere.mjs';
import { aktiveStellen } from '../../lib/stellen';
import { dkArtikel } from '../../lib/dienst-karriere';

const alle = await aktiveStellen();
// Neueste Stellen, Berufsfelder gemischt: je Feld die neueste, dann weiter reihum
const nachFeld = new Map<string, any[]>();
for (const s of [...alle].sort((a, b) => b.data.datum.localeCompare(a.data.datum))) { if (!nachFeld.has(s.feld.slug)) nachFeld.set(s.feld.slug, []); nachFeld.get(s.feld.slug)!.push(s); }
const neueste: any[] = [];
for (let i = 0; neueste.length < 8 && i < 50; i++) for (const liste of nachFeld.values()) if (liste[i] && neueste.length < 8) neueste.push(liste[i]);
const plzListe = alle.filter((s) => s.data.plz).map((s) => [s.data.plz, s.data.title, s.data.organisation, s.data.ort, s.id]);
const artikel = (await dkArtikel()).slice(0, 6);
const fmt = (d: string) => new Date(d).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<Base title="Dienst & Karriere: Gehalt, Tarif, Laufbahn und Stellen im kommunalen Dienst"
  description="TVöD-Rechner für Brutto, Netto, Stufenaufstieg und Jahressonderzahlung, Entgelttabelle 2026 und aktuelle Stellen kommunaler Arbeitgeber – für alle Beschäftigten der Kommunalverwaltung.">
<Header />
<DkKopf />
<main class="dk-main">
  <section class="dk-sek">
    <h2>Rechner</h2>
    <div class="dk-karten">{RECHNER.map((r) => <a class="dk-karte" href={`/dienst-karriere/rechner/${r.slug}/`}><b>{r.name}</b><span>{r.kurz}</span></a>)}</div>
  </section>

  <section class="dk-sek dk-zwei">
    <div>
      <h2>Neueste Stellen</h2>
      <ul class="dk-stellen">{neueste.map((s) => <li><a href={`/stellen/${s.id}/`}><b>{s.data.title}</b><span>{s.data.organisation} · {s.data.ort} · {s.data.entgelt} · bis {fmt(s.data.bewerbungsschluss)}</span></a></li>)}</ul>
      <a class="dk-mehr" href="/stellen/">Alle {alle.length} Stellen →</a>
    </div>
    <div class="dk-naehe">
      <h2>Stellen in Ihrer Nähe</h2>
      <form id="plzForm" class="dk-plz"><label for="plz">Postleitzahl</label><input id="plz" inputmode="numeric" pattern="[0-9]{2,5}" maxlength="5" placeholder="z. B. 01067" /><button type="submit">Suchen</button></form>
      <p class="dk-klein">Die Suche läuft nur in Ihrem Browser; die Eingabe wird nicht gespeichert. Gesucht wird in der Postleitregion (erste zwei Ziffern), bei wenigen Treffern im weiteren Umkreis (erste Ziffer).</p>
      <ul id="plzErg" class="dk-stellen"></ul>
    </div>
  </section>

  <section class="dk-sek">
    <h2>Themen</h2>
    <div class="dk-karten">{BEREICHE.map((b) => <a class="dk-karte" href={`/dienst-karriere/${b.slug}/`}><b>{b.name}</b><span>{b.text}</span></a>)}</div>
  </section>

  {artikel.length > 0 && (
    <section class="dk-sek"><h2>Neue Beiträge</h2>
      <ul class="dk-stellen">{artikel.map((a: any) => <li><a href={`/dienst-karriere/${a.data.cluster}/${a.id}/`}><b>{a.data.title}</b><span>{a.data.beschreibung}</span></a></li>)}</ul>
    </section>
  )}

  <DkNewsletter />
</main>
<Footer />
<script type="application/json" id="plzDaten" set:html={JSON.stringify(plzListe)} />
</Base>
<script>
const daten: [string, string, string, string, string][] = JSON.parse(document.getElementById('plzDaten')!.textContent || '[]');
const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
document.getElementById('plzForm')!.addEventListener('submit', (e) => {
  e.preventDefault();
  const plz = (document.getElementById('plz') as HTMLInputElement).value.trim();
  const ziel = document.getElementById('plzErg')!;
  if (!/^\d{2,5}$/.test(plz)) { ziel.innerHTML = '<li class="dk-klein">Bitte mindestens die ersten zwei Ziffern der Postleitzahl eingeben.</li>'; return; }
  let treffer = daten.filter((d) => d[0].startsWith(plz.slice(0, 2)));
  let weit = false;
  if (treffer.length < 3) { treffer = daten.filter((d) => d[0].startsWith(plz[0])); weit = true; }
  ziel.innerHTML = treffer.length
    ? `<li class="dk-klein">${treffer.length} Stellen ${weit ? 'in der Postleitzone ' + plz[0] : 'in der Postleitregion ' + plz.slice(0, 2)}</li>` + treffer.slice(0, 12).map((d) => `<li><a href="/stellen/${d[4]}/"><b>${esc(d[1])}</b><span>${esc(d[2])} · ${esc(d[0])} ${esc(d[3])}</span></a></li>`).join('')
    : '<li class="dk-klein">In dieser Postleitzone sind aktuell keine Stellen ausgeschrieben – alle Stellen stehen in der <a href="/stellen/">Stellenbörse</a>.</li>';
});
</script>
<style is:global>
.dk-main { max-width:1040px; margin:0 auto; padding:30px 28px 64px; color:#0f172a; }
.dk-sek { margin-bottom:34px; } .dk-sek h2 { font-family:'Playfair Display',Georgia,serif; font-size:24px; color:#14532d; margin:0 0 14px; }
.dk-karten { display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:12px; }
.dk-karte { display:block; background:#fff; border:1px solid #e2e8f0; border-left:4px solid #15803d; border-radius:8px; padding:14px 16px; text-decoration:none; color:#0f172a; }
.dk-karte:hover { border-color:#15803d; } .dk-karte b { display:block; font-size:15.5px; margin-bottom:4px; } .dk-karte span { font-size:13px; color:#475569; line-height:1.5; }
.dk-zwei { display:grid; grid-template-columns:1.2fr 1fr; gap:28px; }
.dk-stellen { list-style:none; padding:0; margin:0 0 10px; } .dk-stellen li { border-bottom:1px solid #f1f5f9; } .dk-stellen a { display:block; padding:9px 0; text-decoration:none; color:#0f172a; }
.dk-stellen b { display:block; font-size:14.5px; } .dk-stellen span { font-size:12.5px; color:#64748b; }
.dk-mehr { color:#15803d; font-weight:700; text-decoration:none; font-size:14px; }
.dk-naehe { background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px; padding:18px 20px; align-self:start; }
.dk-plz { display:flex; gap:8px; align-items:center; flex-wrap:wrap; } .dk-plz label { font-weight:600; font-size:14px; } .dk-plz input { padding:9px 11px; border:1.5px solid #86efac; border-radius:6px; font-size:15px; width:120px; } .dk-plz button { background:#15803d; color:#fff; border:0; border-radius:6px; padding:10px 14px; font-weight:700; cursor:pointer; }
.dk-klein { font-size:12.5px; color:#475569; line-height:1.5; margin:10px 0; }
@media (max-width:760px) { .dk-zwei { grid-template-columns:1fr; } .dk-main { padding:22px 16px 48px; } }
</style>
