---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  return [
    { params:{ressort:'haushalt'},  props:{label:'Haushalt & Finanzen',   sub:'Strukturelle Analyse kommunaler Haushalte',          color:'#c2410c'} },
    { params:{ressort:'einnahmen'}, props:{label:'Einnahmen erschließen', sub:'Konkrete Maßnahmen zur Einnahmenoptimierung',         color:'#3b82f6'} },
    { params:{ressort:'ausgaben'},  props:{label:'Ausgaben steuern',      sub:'Ohne Pflichtleistungen zu kürzen',                   color:'#1e40af'} },
    { params:{ressort:'praxis'},    props:{label:'Best Practice',         sub:'Was funktioniert hat — Fallstudien und Modelle',     color:'#92400e'} },
    { params:{ressort:'recht'},     props:{label:'Recht & Vergabe',       sub:'Aktuelle Rechtsprechung und Vergabepraxis',          color:'#6b21a8'} },
    { params:{ressort:'analyse'},      props:{label:'Analyse & Meinung',     sub:'Einordnung und Kommentar',                                  color:'#374151'} },
    { params:{ressort:'sozialkosten'}, props:{label:'Sozialkosten',          sub:'HzE · Grundsicherung · Asyl · Wohnungslosigkeit — der größte Haushaltshebel', color:'#be123c'} },
    { params:{ressort:'konzern'},      props:{label:'Konzern Kommune',       sub:'Stadtwerke · Wohnungsgesellschaften · Verkehr — Beteiligungen und ihr Gewicht im Haushalt', color:'#0f766e'} },
  ];
}

const { label, sub, color } = Astro.props;
const { ressort } = Astro.params;

const allHaushalt  = await getCollection('haushalt');
const allEinnahmen = await getCollection('einnahmen');
const allAusgaben  = await getCollection('ausgaben');
const allPraxis    = await getCollection('praxis');
const allRecht     = await getCollection('recht');
const allAnalyse      = await getCollection('analyse');
const allSozialkosten = await getCollection('sozialkosten');
const allKonzern      = await getCollection('konzern');

const map: Record<string, any[]> = {
  haushalt:     allHaushalt,
  einnahmen:    allEinnahmen,
  ausgaben:     allAusgaben,
  praxis:       allPraxis,
  recht:        allRecht,
  analyse:      allAnalyse,
  sozialkosten: allSozialkosten,
  konzern:      allKonzern,
};

const entries = (map[ressort] || []).sort((a: any, b: any) =>
  new Date(b.data.datum).getTime() - new Date(a.data.datum).getTime()
);

// Konzern Kommune: nach Branchen und Querschnittsthemen gegliedert (MK 13.10.2026)
const KONZERN_GRUPPEN = [
  { key: 'energie',      label: 'Stadtwerke & Energie',       art: 'Branche' },
  { key: 'wohnen',       label: 'Wohnungsgesellschaften',     art: 'Branche' },
  { key: 'verkehr',      label: 'Verkehr & ÖPNV',             art: 'Branche' },
  { key: 'entsorgung',   label: 'Entsorgung & Wasser',        art: 'Branche' },
  { key: 'steuern',      label: 'Steuern',                    art: 'Querschnitt' },
  { key: 'finanzierung', label: 'Finanzierung & Risiko',      art: 'Querschnitt' },
  { key: 'steuerung',    label: 'Beteiligungssteuerung',      art: 'Querschnitt' },
  { key: 'personal',     label: 'Personal & Vergütung',       art: 'Querschnitt' },
];
const gruppen = ressort === 'konzern'
  ? [...KONZERN_GRUPPEN.map((g) => ({ ...g, artikel: entries.filter((a: any) => a.data.cluster === g.key) })),
     { key: 'weitere', label: 'Weitere Beiträge', art: '', artikel: entries.filter((a: any) => !KONZERN_GRUPPEN.some((g) => g.key === a.data.cluster)) }]
      .filter((g) => g.artikel.length)
  : [{ key: 'alle', label: '', art: '', artikel: entries }];

function getSlug(entry: any) {
  return (entry.id as string).split('/').pop()!.replace('.md','');
}
---
<Base title={`${label} – Fachbeiträge für Kämmerer`} description={`${label}: ${sub}. ${entries.length} quellengesicherte Fachbeiträge für Kämmerer, Finanzdezernenten und Verwaltungsspitzen – werbefrei und mit Zahlen je Kommune.`}>
<Header />
<style>
  .res-hero-inner{max-width:1200px;margin:0 auto;padding:0 32px}
  .res-main{max-width:1200px;margin:0 auto;padding:36px 32px}
  .res-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .res-sprung{display:grid;gap:8px;margin:0 0 28px}
  .res-sprung div{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .res-sprung span{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#64748b;min-width:92px}
  .res-sprung a{font-size:13px;color:#1a2744;text-decoration:none;border:1px solid #cbd5e1;border-radius:20px;padding:5px 12px;background:#fff}
  .res-sprung a:hover{border-color:#0f766e;color:#0f766e}
  .res-sprung a i{font-style:normal;color:#0f766e;font-weight:700;margin-left:3px}
  .res-gruppe{margin-bottom:36px;scroll-margin-top:80px}
  .res-gruppe-titel{font-size:20px;font-weight:800;color:#1a2744;margin:0 0 14px;padding-bottom:8px;border-bottom:2px solid #e2e8f0}
  .res-gruppe-titel small{display:block;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#0f766e;margin-bottom:2px}
  .res-gruppe-titel em{font-style:normal;font-size:13px;color:#64748b;font-weight:600;margin-left:6px}
  @media(max-width:1024px){.res-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:768px){
    .res-hero-inner,.res-main{padding:0 16px}
    .res-main{padding-top:24px}
    .res-grid{grid-template-columns:1fr}
  }
</style>
<div style={`background:linear-gradient(135deg,#1a2744 0%,#0f3460 60%,#1a3a5c 100%);padding:40px 0;`}>
  <div class="res-hero-inner">
    <div style={`font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:${color};margin-bottom:10px;`}>Ressort</div>
    <h1 style="font-size:28px;font-weight:800;color:#fff;margin-bottom:6px;letter-spacing:-.02em;">{label}</h1>
    <p style="font-size:13px;color:#93c5fd;">{sub}</p>
  </div>
</div>
<main class="res-main">
  {entries.length === 0 ? (
    <p style="color:#6b7280;font-size:14px;">Bald verfügbar — erste Artikel in Vorbereitung.</p>
  ) : (
    <>
      <div style="font-size:12px;color:#6b7280;margin-bottom:20px;">{entries.length} Artikel in diesem Ressort</div>
      {gruppen.length > 1 && (
        <nav class="res-sprung">
          {['Branche', 'Querschnitt'].map((art) => gruppen.some((g) => g.art === art) && (
            <div><span>{art === 'Branche' ? 'Branchen' : 'Querschnitt'}</span>
              {gruppen.filter((g) => g.art === art).map((g) => <a href={`#${g.key}`}>{g.label} <i>{g.artikel.length}</i></a>)}</div>
          ))}
        </nav>
      )}
      {gruppen.map((g) => (
      <section id={g.key} class="res-gruppe">
      {g.label && <h2 class="res-gruppe-titel"><small>{g.art}</small>{g.label} <em>{g.artikel.length}</em></h2>}
      <div class="res-grid">
        {g.artikel.map((a: any) => (
          <div style={`background:#fff;border:1px solid #e2e8f0;border-top:3px solid ${color};border-radius:4px;padding:18px;`}>
            {a.data.tag && (
              <span style="display:inline-block;background:#eff6ff;color:#1e40af;border:1px solid #93c5fd;font-size:9px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:1px 6px;border-radius:2px;margin-bottom:10px;">
                {a.data.tag}
              </span>
            )}
            <a href={`/${ressort}/${getSlug(a)}/`}>
              <h2 style="font-size:15px;font-weight:700;line-height:1.35;color:#1a2744;margin-bottom:8px;letter-spacing:-.01em;">{a.data.title}</h2>
            </a>
            <p style="font-size:12px;color:#374151;line-height:1.6;margin-bottom:12px;">{a.data.beschreibung}</p>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-size:10px;color:#9ca3af;">{a.data.datum} · {a.data.minuten} Min.</span>
              <a href={`/${ressort}/${getSlug(a)}/`} style={`font-size:10px;font-weight:700;color:${color};letter-spacing:.05em;`}>Lesen →</a>
            </div>
          </div>
        ))}
      </div>
      </section>
      ))}
    </>
  )}
</main>
<Footer />
</Base>
