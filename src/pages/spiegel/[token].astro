---
// „Personal- und Haushaltslage Ihrer Kommune – diese Woche“ – persönlicher Zugang per Token, nicht indexiert.
export const prerender = false;
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import markt from '../../data/markt/markt.json';
import sperren from '../../data/haushaltslage/sperren.json';
import gemeinden from '../../data/spiegel/gemeinden.json';
import hebesaetze from '../../data/spiegel/hebesaetze.json';
import schulden from '../../data/spiegel/schulden.json';
import zugaenge from '../../data/spiegel/zugaenge.json';
import { spiegel, kalenderwoche } from '../../lib/spiegel.mjs';
import { niveauText } from '../../lib/markt/merkmale.mjs';

const token = Astro.params.token || '';
const z = (zugaenge as any[]).find((x) => x.token === token);
if (!z) return Astro.redirect('/kaemmerer-cockpit/', 302);
const s = spiegel(z.ags, { gemeinden, markt, sperren, hebesaetze, schulden });
if (!s) return Astro.redirect('/', 302);
const { gemeinde: g, personal: p, haushalt: h, finanzen: f } = s;
const kw = kalenderwoche();
const heute = new Date().toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
const pz = (x: number | null) => (x == null ? '–' : Math.round(x * 100) + ' %');
const zahl = (x: number | null, e = '') => (x == null ? '–' : Math.round(x).toLocaleString('de-DE') + e);
const pfeil = (w: number | null, v: number | null) => (w == null || v == null ? '' : w > v * 1.02 ? '▲' : w < v * 0.98 ? '▼' : '●');
---
<Base title={`Personal- und Haushaltslage ${g.name} – KW ${kw}`} description="Persönlicher Lagebericht von Der Kämmerer" noindex={true}>
<Header />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<style>
.sp { color:#0f172a; } .sp-w { max-width:1040px; margin:0 auto; padding:0 28px; }
.sp-kopf { background:#172840; color:#fff; padding:40px 0 34px; border-bottom:3px solid #2563eb; }
.sp-k { font-size:11px; font-weight:700; letter-spacing:.2em; text-transform:uppercase; color:#93c5fd; }
.sp-kopf h1 { font-family:'Playfair Display',Georgia,serif; font-size:clamp(28px,4vw,44px); line-height:1.1; margin:10px 0 8px; }
.sp-kopf .sp-meta { color:rgba(255,255,255,.65); font-size:14px; }
.sp-saetze { margin:26px 0 0; padding:20px 22px; background:rgba(255,255,255,.06); border-left:3px solid #93c5fd; border-radius:6px; }
.sp-saetze p { margin:0 0 8px; font-size:16px; line-height:1.55; color:#e2e8f0; } .sp-saetze p:last-child { margin:0; }
.sp-abschnitt { padding:36px 0 6px; }
.sp-abschnitt h2 { font-family:'Playfair Display',Georgia,serif; font-size:26px; margin:0 0 4px; }
.sp-unter { color:#64748b; font-size:14px; margin:0 0 18px; }
.sp-kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:#e2e8f0; border:1px solid #e2e8f0; border-radius:10px; overflow:hidden; }
.sp-kpis div { background:#fff; padding:16px; } .sp-kpis b { display:block; font-size:26px; font-variant-numeric:tabular-nums; color:#172840; } .sp-kpis span { font-size:12px; color:#64748b; }
.sp-zwei { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:20px; }
.sp-karte { border:1px solid #e2e8f0; border-radius:10px; padding:18px 20px; background:#fff; }
.sp-karte h3 { margin:0 0 12px; font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:#64748b; }
.sp-zeile { display:flex; justify-content:space-between; gap:12px; font-size:14px; padding:6px 0; border-bottom:1px solid #f1f5f9; } .sp-zeile:last-child { border:0; }
.sp-zeile small { color:#64748b; white-space:nowrap; } .sp-zeile a { color:#0f172a; text-decoration:none; font-weight:600; } .sp-zeile a:hover { color:#2563eb; }
.sp-tab { width:100%; border-collapse:collapse; font-size:14px; } .sp-tab th { text-align:left; font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:#64748b; padding:8px; border-bottom:1px solid #e2e8f0; }
.sp-tab td { padding:10px 8px; border-bottom:1px solid #f1f5f9; font-variant-numeric:tabular-nums; } .sp-tab td b { font-size:16px; }
.sp-hin { font-size:12px; color:#64748b; margin:10px 0 0; }
.sp-cta { margin:40px 0 60px; background:#172840; color:#fff; border-radius:12px; padding:30px; display:grid; grid-template-columns:1.4fr 1fr; gap:24px; align-items:center; }
.sp-cta h2 { font-family:'Playfair Display',Georgia,serif; margin:0 0 8px; font-size:24px; } .sp-cta p { margin:0; color:rgba(255,255,255,.72); line-height:1.6; }
.sp-btn { display:inline-block; background:#2563eb; color:#fff; font-weight:700; padding:12px 18px; border-radius:6px; text-decoration:none; margin:0 8px 8px 0; } .sp-btn.hell { background:#fff; color:#172840; }
@media (max-width:820px){ .sp-w{padding:0 16px} .sp-kpis{grid-template-columns:repeat(2,1fr)} .sp-zwei,.sp-cta{grid-template-columns:1fr} }
</style>

<div class="sp">
  <section class="sp-kopf"><div class="sp-w">
    <div class="sp-k">Der Kämmerer · Lagebericht · Kalenderwoche {kw}</div>
    <h1>Personal- und Haushaltslage {g.name}</h1>
    <div class="sp-meta">{zahl(g.einwohner)} Einwohner · {g.kreis ? `${g.kreis} · ` : ''}{g.landLang} · Stand {heute}</div>
    {s.saetze.length > 0 && <div class="sp-saetze">{s.saetze.map((t) => <p>{t}</p>)}</div>}
  </div></section>

  <div class="sp-w">
    <section class="sp-abschnitt">
      <h2>Personalmarkt im Umkreis von 50 km</h2>
      <p class="sp-unter">Aktive Ausschreibungen anderer kommunaler Arbeitgeber – erfasst aus {markt.kopf.anzahl.toLocaleString('de-DE')} öffentlichen Stellen bundesweit.</p>
      <div class="sp-kpis">
        <div><b>{p.anzahl}</b><span>offene Stellen bei {p.arbeitgeberZahl} Arbeitgebern</span></div>
        <div><b>{p.finanz}</b><span>davon im Finanzwesen{p.finanzMedian ? ` · Median ${niveauText(p.finanzMedian)}` : ''}</span></div>
        <div><b>{niveauText(p.median)}</b><span>Median-Entgelt aller Stellen</span></div>
        <div><b>{pz(p.homeoffice)}</b><span>bieten Homeoffice · {pz(p.befristet)} befristet</span></div>
      </div>
      <div class="sp-zwei">
        <div class="sp-karte"><h3>Wer um Finanzpersonal wirbt</h3>
          {p.finanzStellen.length ? p.finanzStellen.map((x) => <div class="sp-zeile"><a href={x.u} target="_blank" rel="noopener">{x.t}<br><small style="font-weight:400">{x.o}</small></a><small>{niveauText(x.n)} · {x.km} km</small></div>) : <p class="sp-hin">Derzeit keine Finanzstellen anderer Kommunen im Umkreis erfasst.</p>}
        </div>
        <div class="sp-karte"><h3>Wo im Umfeld am meisten gesucht wird</h3>
          {p.felder.map((x) => <div class="sp-zeile"><span>{x.name}</span><small>{x.n} Stellen</small></div>)}
          <h3 style="margin-top:18px">Häufigste Arbeitgeberleistungen im Umfeld</h3>
          {p.leistungen.map((x) => <div class="sp-zeile"><span>{x.name}</span><small>{pz(x.anteil)}</small></div>)}
        </div>
      </div>
      {p.eigene.length > 0 && <p class="sp-hin">Ihre eigenen aktiven Ausschreibungen ({p.eigene.length}) vergleichen wir im <a href="/arbeitgeberservice/#personal-cockpit">Personal-Cockpit</a> einzeln mit dem Markt.</p>}
    </section>

    <section class="sp-abschnitt">
      <h2>Haushaltslage im Umfeld</h2>
      <p class="sp-unter">Von der Redaktion belegte Haushaltssperren seit 2025 – {h.bundesweit} Fälle bundesweit, {h.imLand} in {g.landLang}. Stand {new Date(h.stand).toLocaleDateString('de-DE')}.</p>
      <div class="sp-karte">
        <h3>Nächstgelegene Haushaltssperren</h3>
        {h.naechste.map((x) => <div class="sp-zeile"><span><b>{x.kommune}</b> · {x.art}</span><small>{x.km} km</small></div>)}
        <p class="sp-hin">Alle Fälle mit Quellen: <a href="/haushalt/haushaltssperre-2026-stadte/">Haushaltssperre 2026 – Liste, Rechtsgrundlagen, Folgen</a></p>
      </div>
    </section>

    {(f.grundsteuerB.wert != null || f.schulden.wert != null) && (
    <section class="sp-abschnitt">
      <h2>Hebesätze und Verschuldung im Vergleich</h2>
      <p class="sp-unter">Amtliche Statistik, jeweils jüngstes verfügbares Berichtsjahr. Vergleich mit dem Median Ihres Kreises, Ihres Landes und gleich großer Gemeinden im Land (± 50 % Einwohner).</p>
      <div class="sp-karte"><table class="sp-tab">
        <thead><tr><th></th><th>{g.name}</th><th>{f.kreisLabel}</th><th>Land</th><th>Gleich groß</th><th>Rang im Land</th></tr></thead>
        <tbody>
          {[['Grundsteuer B (Hebesatz)', f.grundsteuerB, ' %'], ['Gewerbesteuer (Hebesatz)', f.gewerbesteuer, ' %'], ['Schulden Kernhaushalt je Einwohner', f.schulden, ' €'], ['davon Kassenkredite je Einwohner', f.kassenkredite, ' €'], ['Schulden der 100-%-Beteiligungen je Einwohner', f.beteiligungen, ' €']].filter(([, v]: any) => v.wert != null).map(([n, v, e]: any) => (
            <tr><td>{n}<br><small style="color:#64748b">{v.jahr}</small></td><td><b>{zahl(v.wert, e)}</b> {pfeil(v.wert, v.kreis)}</td><td>{zahl(v.kreis, e)}</td><td>{zahl(v.land, e)}</td><td>{zahl(v.groesse, e)}</td><td>{v.rangLand ? `${v.rangLand.platz} von ${v.rangLand.von}` : '–'}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="sp-hin">Hebesätze 2024 nach altem Grundsteuerrecht (die reformierten Sätze ab 2025 liegen amtlich noch nicht vor). Schulden zum 31.12.2025; bei Mitgliedsgemeinden von Ämtern und Verbandsgemeinden ohne deren Anteil am Verband. ▲ über / ▼ unter dem Vergleichsmedian. Rang 1 = höchster Wert im Land. Quelle: Statistische Ämter des Bundes und der Länder (Datenlizenz Deutschland – Namensnennung 2.0). Lange Zeitreihen bietet zusätzlich der Wegweiser Kommune der Bertelsmann Stiftung.</p></div>
    </section>
    )}

    <div class="sp-cta">
      <div><h2>Jeden Monat neu – im Kämmerer-Briefing</h2><p>Der Kämmerer ist das unabhängige Briefing für kommunale Entscheider: werbefrei, auf den Punkt. Mit dem Briefing erhalten Sie diesen Lagebericht für {g.name} monatlich aktualisiert.</p></div>
      <div><a class="sp-btn hell" href="/newsletter/#anmelden">Briefing abonnieren</a><a class="sp-btn" href="/kaemmerer-cockpit/">Kämmerer-Cockpit ansehen</a></div>
    </div>
  </div>
</div>
<Footer />
</Base>
