---
// Personal-Cockpit – öffentliche Produktseite (personal.derkaemmerer.de)
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import markt from '../../data/markt/markt.json';
import { ueberblick, niveauText } from '../../lib/markt/benchmark.mjs';

const u = ueberblick(markt.stellen);
const stand = new Date(markt.kopf.stand).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
const pz = (x: number | null) => (x == null ? '–' : Math.round(x * 100) + ' %');
const felder = u.feld.filter((f) => f.k !== 'sonstiges').slice(0, 8);
const maxF = Math.max(...felder.map((f) => f.anzahl));
---
<Base title="Personal-Cockpit – Ihre Stellen im Vergleich mit dem kommunalen Stellenmarkt"
  description={`Personal-Cockpit von Der Kämmerer: Jede kommunale Ausschreibung im Vergleich mit ${u.anzahl.toLocaleString('de-DE')} aktiven Stellen – Entgelt, Leistungen, Wettbewerb im Umkreis und KI-Vorschlag für einen stärkeren Ausschreibungstext.`}
  canonical="https://personal.derkaemmerer.de/">
<Header />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<style>
.lp { --navy:#172840; --blau:#2563eb; --hell:#93c5fd; --muted:#64748b; --linie:#e2e8f0; color:#0f172a; }
.lp-w { max-width:1120px; margin:0 auto; padding:0 32px; }
.lp-hero { background:radial-gradient(1200px 400px at 85% -10%, rgba(37,99,235,.35), transparent 60%), var(--navy); color:#fff; padding:72px 0 60px; border-bottom:3px solid var(--blau); }
.lp-k { font-size:11px; font-weight:700; letter-spacing:.22em; text-transform:uppercase; color:var(--hell); }
.lp-hero h1 { font-family:'Playfair Display',Georgia,serif; font-size:clamp(34px,5vw,58px); line-height:1.05; margin:14px 0 18px; max-width:18ch; }
.lp-hero p { font-size:18px; color:rgba(255,255,255,.72); max-width:58ch; margin:0 0 30px; }
.lp-cta { display:inline-block; background:#fff; color:var(--navy); font-weight:800; padding:14px 22px; border-radius:8px; text-decoration:none; margin-right:10px; }
.lp-cta2 { display:inline-block; color:#fff; font-weight:700; padding:14px 6px; text-decoration:none; border-bottom:2px solid var(--hell); }
.lp-live { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:rgba(255,255,255,.12); border-radius:8px; overflow:hidden; margin-top:44px; }
.lp-live div { background:rgba(15,25,45,.6); padding:18px; } .lp-live b { display:block; font-size:30px; font-variant-numeric:tabular-nums; } .lp-live span { font-size:11px; text-transform:uppercase; letter-spacing:.08em; color:rgba(255,255,255,.55); }
.lp-s { padding:64px 0 10px; } .lp-s h2 { font-family:'Playfair Display',Georgia,serif; font-size:34px; margin:0 0 10px; } .lp-s > .lp-w > p { color:var(--muted); max-width:66ch; font-size:16px; }
.lp-drei { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:28px; }
.lp-drei article { border:1px solid var(--linie); border-radius:12px; padding:24px; background:#fff; box-shadow:0 12px 30px -26px rgba(15,23,42,.5); }
.lp-drei b { display:grid; place-items:center; width:34px; height:34px; border-radius:50%; background:var(--navy); color:#fff; margin-bottom:12px; }
.lp-drei h3 { margin:0 0 8px; font-size:18px; } .lp-drei p { margin:0; color:#334155; font-size:14.5px; line-height:1.6; }
.lp-zwei { display:grid; grid-template-columns:1fr 1fr; gap:22px; margin-top:26px; }
.lp-box { border:1px solid var(--linie); border-radius:12px; padding:22px; }
.lp-box h4 { margin:0 0 14px; font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); }
.lp-bar { display:grid; grid-template-columns:190px 1fr 54px; gap:10px; align-items:center; font-size:13.5px; margin:7px 0; }
.lp-bar i { display:block; height:8px; background:#e2e8f0; border-radius:4px; overflow:hidden; } .lp-bar em { display:block; height:100%; background:var(--blau); }
.lp-bar small { text-align:right; color:var(--muted); font-variant-numeric:tabular-nums; }
.lp-ende { margin:60px 0 70px; background:var(--navy); color:#fff; border-radius:14px; padding:40px; display:grid; grid-template-columns:1.4fr 1fr; gap:30px; align-items:center; }
.lp-ende h2 { font-family:'Playfair Display',Georgia,serif; font-size:30px; margin:0 0 10px; } .lp-ende p { color:rgba(255,255,255,.7); margin:0; }
.lp-fuss { color:var(--muted); font-size:12px; margin:-40px 0 50px; }
@media (max-width:860px){ .lp-w{padding:0 16px} .lp-live{grid-template-columns:repeat(2,1fr)} .lp-drei,.lp-zwei,.lp-ende{grid-template-columns:1fr} .lp-bar{grid-template-columns:120px 1fr 46px} }
</style>

<div class="lp">
  <section class="lp-hero"><div class="lp-w">
    <div class="lp-k">Personal-Cockpit · Der Kämmerer</div>
    <h1>Ihre Stelle gegen den gesamten kommunalen Stellenmarkt.</h1>
    <p>Das Personal-Cockpit vergleicht jede Ihrer Ausschreibungen mit tausenden aktiven Stellen anderer Kommunen – Entgelt, Arbeitgeberleistungen, Homeoffice, Befristung und Wettbewerb im Umkreis. Und es schreibt Ihnen einen stärkeren Ausschreibungstext.</p>
    <a class="lp-cta" href="https://derkaemmerer.de/stellenanzeigen">Mit der KommunalFlat freischalten</a>
    <a class="lp-cta2" href="mailto:service@derkaemmerer.de?subject=Personal-Cockpit">Zugang anfragen →</a>
    <div class="lp-live">
      <div><b>{u.anzahl.toLocaleString('de-DE')}</b><span>aktive kommunale Stellen</span></div>
      <div><b>{u.arbeitgeber.toLocaleString('de-DE')}</b><span>kommunale Arbeitgeber</span></div>
      <div><b>{pz(u.kz.homeoffice)}</b><span>bieten Homeoffice</span></div>
      <div><b>{niveauText(u.kz.niveau.median)}</b><span>Median-Entgelt</span></div>
    </div>
  </div></section>

  <section class="lp-s"><div class="lp-w">
    <h2>So arbeitet das Cockpit</h2>
    <p>Täglich erfasst, ausgewertet und für Ihre Stelle verdichtet – Stand {stand}.</p>
    <div class="lp-drei">
      <article><b>1</b><h3>Marktvergleich je Stelle</h3><p>Jede Ausschreibung wird mit vergleichbaren Stellen verglichen: gleiches Funktionsfeld, gleiche Entgeltstufe, bevorzugt im eigenen Land. Ergebnis: Attraktivitätsindex, Ampel und Ihre Position im Entgeltband.</p></article>
      <article><b>2</b><h3>Wettbewerb im Umkreis</h3><p>Wer wirbt in 50 Kilometern um dieselben Fachkräfte – und wer zahlt mehr? Das Cockpit zeigt die konkurrierenden Arbeitgeber und den Wettbewerbsdruck für jede Stelle.</p></article>
      <article><b>3</b><h3>Stärkere Ausschreibung</h3><p>Vor der Veröffentlichung prüfen: Text einfügen, Marktvergleich in Sekunden erhalten – und einen überarbeiteten Ausschreibungstext mit konkreten Hinweisen zur Ausgestaltung der Stelle.</p></article>
    </div>
  </div></section>

  <section class="lp-s"><div class="lp-w">
    <h2>Der kommunale Stellenmarkt heute</h2>
    <p>Ein Ausschnitt aus den Daten, mit denen das Cockpit jede Stelle bewertet.</p>
    <div class="lp-zwei">
      <div class="lp-box"><h4>Aktive Stellen nach Funktionsfeld</h4>
        {felder.map((f) => <div class="lp-bar"><span>{f.name}</span><i><em style={`width:${(f.anzahl / maxF) * 100}%`}></em></i><small>{f.anzahl.toLocaleString('de-DE')}</small></div>)}
      </div>
      <div class="lp-box"><h4>Häufigste Arbeitgeberleistungen in Ausschreibungen</h4>
        {u.top.slice(0, 8).map((t) => <div class="lp-bar"><span>{t.name}</span><i><em style={`width:${(t.anteil ?? 0) * 100}%`}></em></i><small>{pz(t.anteil)}</small></div>)}
      </div>
    </div>
  </div></section>

  <div class="lp-w">
    <div class="lp-ende">
      <div><h2>Teil der KommunalFlat</h2><p>Das Personal-Cockpit ist für KommunalFlat-Partner freigeschaltet – zusammen mit Vorrang in der Stellenbörse, eigenem Arbeitgeberprofil und Veröffentlichung am selben Tag.</p></div>
      <div><a class="lp-cta" href="https://derkaemmerer.de/stellenanzeigen">KommunalFlat ansehen</a></div>
    </div>
    <p class="lp-fuss">Datenbasis: öffentlich ausgeschriebene Stellen kommunaler Arbeitgeber, täglich aktualisiert. Entgeltniveau als TVöD-Äquivalent (Besoldung näherungsweise umgerechnet). Index und Ampel sind modellbasierte Einschätzungen.</p>
  </div>
</div>
<Footer />
</Base>
