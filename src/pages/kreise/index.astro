---
// Übersicht aller Landkreise nach Bundesland, mit Median-Hebesätzen und Schulden der Gemeinden.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import gemeinden from '../../data/spiegel/gemeinden.json';
import hebesaetze from '../../data/spiegel/hebesaetze.json';
import schulden from '../../data/spiegel/schulden.json';
import { LAND_LANG } from '../../lib/gemeinden.mjs';
import { kreise, median, gewichtet } from '../../lib/kreise.mjs';

const H = hebesaetze as any, S = schulden as any;
const alle = kreise(gemeinden as any[]).map((k: any) => ({ ...k,
  gb: median(k.gemeinden.map((g: any) => H[g.ags]?.grundsteuer_b || null)),
  sch: gewichtet(k.gemeinden, (g: any) => S[g.ags]?.schulden_je_ew ?? null) }));
const laender = Object.keys(LAND_LANG).filter((l) => alle.some((k) => k.land === l));
const z = (x: number | null, e = '') => (x == null ? '–' : Math.round(x).toLocaleString('de-DE') + e);
---
<Base title="Alle Landkreise in Deutschland: Hebesätze und Schulden der Gemeinden je Kreis"
  description={`${alle.length} Landkreise mit allen Gemeinden: Grundsteuer B und Gewerbesteuer im Median, Schulden je Einwohner, Haushaltssperren und offene Stellen – je Kreis im Vergleich mit dem Land.`}>
<Header />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<style>
.ki { max-width:1080px; margin:0 auto; padding:34px 28px 60px; color:#0f172a; }
.ki h1 { font-family:'Playfair Display',Georgia,serif; font-size:clamp(28px,4vw,42px); margin:6px 0 10px; }
.ki > p { color:#475569; line-height:1.6; max-width:72ch; }
.ki-nav { display:flex; flex-wrap:wrap; gap:6px; margin:18px 0 6px; } .ki-nav a { font-size:13px; border:1px solid #e2e8f0; border-radius:999px; padding:5px 11px; color:#334155; text-decoration:none; }
.ki-land { margin-top:30px; scroll-margin-top:20px; } .ki-land h2 { font-family:'Playfair Display',Georgia,serif; font-size:22px; margin:0 0 10px; padding-bottom:6px; border-bottom:2px solid #172840; }
.ki-raster { display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:10px; }
.ki-raster a { border:1px solid #e2e8f0; border-radius:10px; padding:12px 14px; text-decoration:none; color:#0f172a; background:#fff; transition:border-color .15s, box-shadow .15s; }
.ki-raster a:hover { border-color:#2563eb; box-shadow:0 10px 24px -18px rgba(37,99,235,.7); }
.ki-raster b { display:block; font-size:15px; } .ki-raster span { font-size:12.5px; color:#64748b; }
@media (max-width:700px){ .ki{padding:26px 16px 50px} }
</style>
<div class="ki">
  <div style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2563eb">Kreisprofile</div>
  <h1>Alle {alle.length} Landkreise: Hebesätze und Schulden der Gemeinden</h1>
  <p>Je Kreis eine Karte der Grundsteuer B, alle Gemeinden mit Hebesätzen und Schulden im Vergleich, belegte Haushaltssperren und offene Stellen. Kreisfreie Städte finden Sie im <a href="/gemeinden/" style="color:#2563eb">Gemeindeverzeichnis</a>, die Extremwerte in den <a href="/ranglisten/" style="color:#2563eb">Ranglisten</a>.</p>
  <nav class="ki-nav">{laender.map((l) => <a href={`#${l}`}>{(LAND_LANG as any)[l]}</a>)}</nav>
  {laender.map((l) => (
    <section class="ki-land" id={l}>
      <h2>{(LAND_LANG as any)[l]}</h2>
      <div class="ki-raster">
        {alle.filter((k) => k.land === l).map((k) => <a href={k.url}><b>{k.titel}</b><span>{k.gemeinden.length} Gemeinden · Grundsteuer B {z(k.gb, ' %')} · {z(k.sch, ' €')} Schulden je EW</span></a>)}
      </div>
    </section>
  ))}
</div>
<Footer />
</Base>
