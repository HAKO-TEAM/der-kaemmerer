---
// Punktkarte + Legende: amtlicher Haushaltsstatus aller NRW-Gemeinden (Stand 31.12.2025), Ringe = belegte Haushaltssperren.
import { STUFEN } from '../lib/haushaltsstatus.mjs';
interface Props { a: any; viewBox: string; landPfad: string; quelle: string }
const { a, viewBox, landPfad, quelle } = Astro.props;
---
<style>
.hk { display:grid; grid-template-columns:470px 1fr; gap:30px; align-items:start; }
.hk-karte { background:#f8fafc; border:1px solid #e2e8f0; border-radius:14px; padding:14px; }
.hk-karte svg { width:100%; height:auto; display:block; }
.hk-karte a:hover circle { stroke:#2563eb !important; stroke-width:1.5 !important; }
.hk-z { display:grid; grid-template-columns:14px 1fr 40px 120px; gap:10px; align-items:center; padding:6px 0; border-bottom:1px solid #f1f5f9; font-size:14px; }
.hk-z i { width:12px; height:12px; border-radius:50%; } .hk-z b { text-align:right; font-variant-numeric:tabular-nums; }
.hk-z em { height:8px; background:#f1f5f9; border-radius:4px; overflow:hidden; display:block; } .hk-z s { display:block; height:100%; text-decoration:none; }
.hk-q { font-size:12px; color:#64748b; margin-top:10px; line-height:1.5; }
@media (max-width:900px){ .hk{grid-template-columns:1fr} .hk-karte{max-width:480px; margin:0 auto; width:100%; box-sizing:border-box} .hk-z{grid-template-columns:14px 1fr 34px 70px} }
</style>
<div class="hk">
  <div class="hk-karte">
    <svg viewBox={viewBox} role="img" aria-label="Karte: amtlicher Haushaltsstatus aller Gemeinden in Nordrhein-Westfalen">
      <path d={landPfad} style="fill:#f1f5f9" />
      {a.punkte.map((p: any) => (
        <a href={p.url}><circle cx={p.x} cy={p.y} r={p.r} style={`fill:${(STUFEN as any)[p.s].farbe};stroke:${p.sperre ? '#0f172a' : '#fff'};stroke-width:${p.sperre ? 1.1 : 0.4}`}><title>{p.name}: {(STUFEN as any)[p.s].lang}{p.u === 1 ? ' · überschuldet' : ''}{p.sperre ? ' · Haushaltssperre belegt' : ''}{p.akt ? ` · ${p.akt.kurz} (${p.akt.stand})` : ''}</title></circle></a>
      ))}
    </svg>
  </div>
  <div>
    {Object.entries(STUFEN).map(([k, v]: any) => (
      <div class="hk-z"><i style={`background:${v.farbe}`}></i><span>{v.lang}</span><b>{a.zahl[k]}</b><em><s style={`width:${(a.zahl[k] / a.gesamt) * 100}%;background:${v.farbe}`}></s></em></div>
    ))}
    <div class="hk-z"><i style="background:#fff;border:2px solid #0f172a;box-sizing:border-box"></i><span>davon mit belegter Haushaltssperre seit 2025 (Ring)</span><b>{a.mitSperre.length}</b><em></em></div>
    <p class="hk-q">Punktgröße nach Einwohnerzahl, Klick öffnet das Gemeindeprofil. Quelle: {quelle}; Haushaltssperren: Recherche der Redaktion.</p>
  </div>
</div>
