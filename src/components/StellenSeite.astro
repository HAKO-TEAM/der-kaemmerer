---
// Darstellung einer Stellenliste (Übersicht, Folgeseiten, Landingpages) – Runbook 3.3.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import JobAlert from './JobAlert.astro';
import markt from '../data/markt/markt.json';
import { ueberblick, niveauText } from '../lib/markt/benchmark.mjs';
import { FELDER, LAENDER, type Stelle } from '../lib/stellen';

interface Props {
  seoTitel: string; beschreibung: string; noindex?: boolean;
  label: string; titel: string; untertitel?: string; einleitung?: string;
  pfad?: { name: string; url: string }[];
  alle: Stelle[];            // alle laufenden Stellen (für Navigation und Zähler)
  liste: Stelle[];           // auf dieser Seite angezeigt
  gesamt: number;            // Treffer dieser Auswahl
  seite?: number; seiten?: number; basis?: string;   // Paginierung
  aktivLand?: string; aktivFeld?: string;
  marktZahlen?: boolean;
}
const { seoTitel, beschreibung, noindex = false, label, titel, untertitel, einleitung, pfad = [], alle, liste, gesamt,
  seite = 1, seiten = 1, basis = '/stellen/', aktivLand, aktivFeld, marktZahlen = false } = Astro.props;
const mu = ueberblick(markt.stellen);
const mpz = (x: number | null) => (x == null ? '–' : Math.round(x * 100) + ' %');
const laender = LAENDER(alle).map(([slug, name]) => ({ slug, name, n: alle.filter((s) => s.landSlug === slug).length }));
const felder = FELDER.map((f) => ({ ...f, n: alle.filter((s) => s.feld.slug === f.slug).length })).filter((f) => f.n > 0);
const seitenUrl = (n: number) => (n === 1 ? basis : `${basis}seite/${n}/`);
---
<Base title={seoTitel} description={beschreibung} noindex={noindex}>
<Header />

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">

<style>
.st-container { max-width: 1000px; margin: 0 auto; padding: 0 48px; }

/* HERO */
.st-hero { background: linear-gradient(135deg, #1a2744 0%, #0f3460 60%, #1a3a5c 100%); padding: 56px 0; }
.st-hero-label { font-size: 10px; letter-spacing: 4px; text-transform: uppercase; color: #93c5fd; font-weight: 700; margin-bottom: 10px; }
.st-hero h1 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(28px, 4vw, 44px); font-weight: 700; color: #fff; line-height: 1.15; margin-bottom: 12px; }
.st-hero p { font-size: 15px; color: rgba(255,255,255,.6); line-height: 1.7; max-width: 560px; }
.st-hero-stats { display: flex; gap: 32px; margin-top: 28px; flex-wrap: wrap; }
.st-hero-stat .n { font-size: 28px; font-weight: 700; color: #93c5fd; font-family: 'Playfair Display', serif; display: block; }
.st-hero-stat .l { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,.4); }

/* SUCHE (MK 15.10.2026) */
.st-suche { background: #f1f5f9; border-bottom: 1px solid #e2e8f0; padding: 18px 0; }
.st-suche form { display: grid; grid-template-columns: minmax(220px, 2.4fr) 1fr 1fr 0.9fr auto; gap: 10px; align-items: end; }
.st-suche label { display: block; font-size: 11px; font-weight: 700; color: #6b7280; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 4px; }
.st-suche input[type=search], .st-suche select { width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 14px; font-family: inherit; background: #fff; color: #1a2744; }
.st-suche input[type=search]:focus, .st-suche select:focus { outline: none; border-color: #3b82f6; }
.st-suche-opt { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 10px; font-size: 13px; color: #374151; align-items: center; }
.st-suche-opt label { display: inline-flex; gap: 6px; align-items: center; font-size: 13px; font-weight: 500; text-transform: none; letter-spacing: 0; color: #374151; margin: 0; cursor: pointer; }
.st-suche button { padding: 10px 18px; border: 0; border-radius: 6px; background: #1d4ed8; color: #fff; font-weight: 700; font-size: 14px; cursor: pointer; font-family: inherit; }
.st-suche .st-suche-reset { font-size: 13px; font-weight: 500; color: #1d4ed8; background: none; border: 0; border-radius: 0; cursor: pointer; padding: 0; text-decoration: underline; }
.st-suche-info { font-size: 13px; color: #374151; margin-left: auto; }
@media (max-width: 760px) { .st-suche form { grid-template-columns: 1fr 1fr; } .st-suche form > div:first-child { grid-column: 1 / -1; } .st-suche button { grid-column: 1 / -1; } }

/* FILTER */
.st-filter { background: #fff; border-bottom: 1px solid #e2e8f0; padding: 16px 0; position: sticky; top: 0; z-index: 40; }
.st-filter-inner { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.st-filter select { padding: 8px 28px 8px 12px; border: 1.5px solid #e2e8f0; border-radius: 5px; font-size: 13px; color: #374151; background: #f8fafc; cursor: pointer; font-family: inherit; }
.st-filter select:focus { outline: none; border-color: #3b82f6; }
.st-filter-label { font-size: 12px; font-weight: 700; color: #6b7280; letter-spacing: .04em; text-transform: uppercase; }

/* MAIN */
.st-main { padding: 48px 0 80px; background: #f1f5f9; }
.st-count { font-size: 12px; color: #6b7280; margin-bottom: 24px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }

/* JOB CARD */
.st-card {
  background: #fff; border: 1.5px solid #e2e8f0; border-radius: 8px;
  margin-bottom: 16px; overflow: hidden;
  transition: transform .15s, box-shadow .15s;
  display: block; text-decoration: none; color: inherit;
}
.st-card:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(26,39,68,.1); border-color: #bfdbfe; }
.st-card.premium, .st-card.einzelanzeige { border-left: 4px solid #3b82f6; }
.st-card.exklusiv { border-left: 4px solid #1a2744; background: linear-gradient(to right, #f8faff 0%, #fff 60%); }

.st-card-inner { padding: 24px 28px; display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: start; }

.st-card-badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
  padding: 3px 10px; border-radius: 20px; margin-bottom: 10px;
}
.st-card-badge.premium, .st-card-badge.einzelanzeige  { background: #dbeafe; color: #1d4ed8; }
.st-card-badge.exklusiv { background: #1a2744; color: #93c5fd; }

.st-card-org { font-size: 12px; font-weight: 700; color: #6b7280; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 6px; }
.st-card-title { font-family: 'Playfair Display', Georgia, serif; font-size: 20px; font-weight: 700; color: #1a2744; line-height: 1.25; margin-bottom: 12px; }
.st-card-meta { display: flex; gap: 16px; flex-wrap: wrap; }
.st-card-meta-item { font-size: 12px; color: #374151; display: flex; align-items: center; gap: 5px; }
.st-card-meta-item::before { content: ''; width: 5px; height: 5px; background: #3b82f6; border-radius: 50%; flex-shrink: 0; }

.st-card-right { text-align: right; flex-shrink: 0; }
.st-card-deadline { font-size: 11px; color: #6b7280; margin-bottom: 8px; white-space: nowrap; }
.st-card-deadline.urgent { color: #dc2626; font-weight: 700; }
.st-card-btn {
  display: inline-block; padding: 10px 20px;
  background: #1a2744; color: #fff;
  font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
  border-radius: 4px; text-decoration: none; white-space: nowrap;
  transition: background .15s;
}
.st-card-btn:hover { background: #0f3460; }

/* TAGS */
.st-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
.st-tag { background: #f1f5f9; border: 1px solid #e2e8f0; color: #374151; font-size: 10px; padding: 3px 10px; border-radius: 20px; font-weight: 500; }

/* LEER */
.st-empty { text-align: center; padding: 64px 0; color: #6b7280; }
.st-empty h3 { font-family: 'Playfair Display', serif; font-size: 22px; color: #1a2744; margin-bottom: 10px; }

/* DOSSIER TEASER */
.st-dossier { background: #172840; border-bottom: 2px solid #2563eb; padding: 12px 0; }
.st-dossier-inner { display: flex; align-items: center; gap: 12px; }
.st-dossier-badge { font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; background: rgba(37,99,235,.3); border: 1px solid rgba(96,165,250,.4); color: #93c5fd; padding: 3px 10px; border-radius: 20px; white-space: nowrap; flex-shrink: 0; }
.st-dossier-text { font-size: 13px; color: rgba(255,255,255,.65); flex: 1; }
.st-dossier-text strong { color: #fff; }
.st-dossier-link { font-size: 12px; font-weight: 700; color: #60a5fa; text-decoration: none; white-space: nowrap; flex-shrink: 0; transition: color .15s; }
.st-dossier-link:hover { color: #fff; }

/* CTA */
.st-cta { background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 8px; padding: 28px 32px; display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 32px; }
.st-cta p { font-size: 14px; color: #374151; line-height: 1.6; max-width: 500px; }
.st-cta p strong { color: #1a2744; }
.st-cta-btn { background: #1a2744; color: #fff; padding: 13px 28px; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none; border-radius: 4px; white-space: nowrap; transition: background .15s; }
.st-cta-btn:hover { background: #0f3460; }

@media (max-width: 768px) {
  .st-container { padding: 0 20px; }
  .st-card-inner { grid-template-columns: 1fr; }
  .st-card-right { text-align: left; }
  .st-filter-inner { gap: 8px; }
}

/* Landingpage-Navigation (Runbook 3.3) */
.st-nav { display:flex; flex-direction:column; gap:10px; }
.st-chips { display:flex; flex-wrap:wrap; gap:6px; align-items:center; }
.st-chips a { font-size:12.5px; padding:5px 11px; border:1.5px solid #e2e8f0; border-radius:999px; color:#374151; text-decoration:none; background:#f8fafc; white-space:nowrap; }
.st-chips a:hover { border-color:#3b82f6; color:#1d4ed8; }
.st-chips a.an { background:#1a2744; border-color:#1a2744; color:#fff; font-weight:700; }
.st-chips a small { color:#94a3b8; margin-left:3px; } .st-chips a.an small { color:#93c5fd; }
.st-intro { font-size:14.5px; line-height:1.65; color:#334155; background:#f8fafc; border-left:3px solid #3b82f6; padding:14px 18px; margin:0 0 20px; border-radius:0 6px 6px 0; }
.st-pfad { font-size:12px; color:rgba(255,255,255,.55); margin-bottom:10px; } .st-pfad a { color:#93c5fd; text-decoration:none; }
.st-filter { position:static; }
@media (max-width:768px){ .st-chips { flex-wrap:nowrap; overflow-x:auto; padding-bottom:4px; -webkit-overflow-scrolling:touch; } }
.st-seiten { display:flex; flex-wrap:wrap; gap:6px; justify-content:center; margin:28px 0 8px; }
.st-seiten a, .st-seiten span { min-width:38px; text-align:center; padding:8px 12px; border:1.5px solid #e2e8f0; border-radius:6px; font-size:13px; text-decoration:none; color:#374151; }
.st-seiten span.an { background:#1a2744; color:#fff; border-color:#1a2744; font-weight:700; }
</style>

<!-- HERO -->
<div class="st-hero">
  <div class="st-container">
    {pfad.length > 0 && <div class="st-pfad">{pfad.map((p, i) => <>{i > 0 && ' › '}<a href={p.url}>{p.name}</a></>)}</div>}
    <div class="st-hero-label">{label}</div>
    <h1 set:html={titel} />
    {untertitel && <p>{untertitel}</p>}
    {marktZahlen && (
      <div class="st-hero-stats">
        <div class="st-hero-stat"><span class="n">{alle.length.toLocaleString('de-DE')}</span><span class="l">ausgewählte Stellen · täglich neue</span></div>
        <div class="st-hero-stat"><span class="n">{mu.anzahl.toLocaleString('de-DE')}</span><span class="l">kommunale Stellen im Marktvergleich</span></div>
        <div class="st-hero-stat"><span class="n">{mpz(mu.kz.homeoffice)}</span><span class="l">mit Homeoffice · Median {niveauText(mu.kz.niveau.median)}</span></div>
      </div>
    )}
  </div>
</div>

<!-- SUCHE über alle laufenden Stellen (Index /stellen/suche.json) -->
<div class="st-suche">
  <div class="st-container">
    <form id="stSuche" role="search" action="/stellen/" method="get">
      <div>
        <label for="stQ">Suchbegriff</label>
        <input type="search" id="stQ" name="q" placeholder="z. B. Kämmerer, Controlling, Stadtwerke, Köln" autocomplete="off">
      </div>
      <div>
        <label for="stLand">Bundesland</label>
        <select id="stLand" name="land"><option value="">Alle Länder</option>{laender.map((l) => <option value={l.slug} selected={aktivLand === l.slug}>{l.name}</option>)}</select>
      </div>
      <div>
        <label for="stFeld">Berufsfeld</label>
        <select id="stFeld" name="feld"><option value="">Alle Berufsfelder</option>{felder.map((f) => <option value={f.slug} selected={aktivFeld === f.slug}>{f.name}</option>)}</select>
      </div>
      <div>
        <label for="stEg">Entgelt ab</label>
        <select id="stEg" name="eg"><option value="">beliebig</option>{[8, 9, 10, 11, 12, 13, 14, 15].map((n) => <option value={n}>EG/A {n}</option>)}</select>
      </div>
      <button type="submit">Suchen</button>
    </form>
    <div class="st-suche-opt">
      <label><input type="checkbox" id="stUnbef" name="unbefristet"> nur unbefristet</label>
      <label><input type="checkbox" id="stTz" name="teilzeit"> Teilzeit möglich</label>
      <button type="button" class="st-suche-reset" id="stReset" hidden>Suche zurücksetzen</button>
      <span class="st-suche-info" id="stInfo" aria-live="polite"></span>
    </div>
  </div>
</div>

<!-- NAVIGATION: Bundesland und Berufsfeld -->
<div class="st-filter">
  <div class="st-container st-nav">
    <div class="st-chips"><span class="st-filter-label">Bundesland:</span>
      <a href="/stellen/" class={!aktivLand && !aktivFeld ? 'an' : ''}>Alle<small>{alle.length}</small></a>
      {laender.map((l) => <a href={`/stellen/bundesland/${l.slug}/`} class={aktivLand === l.slug ? 'an' : ''}>{l.name}<small>{l.n}</small></a>)}
    </div>
    <div class="st-chips"><span class="st-filter-label">Berufsfeld:</span>
      {felder.map((f) => <a href={`/stellen/berufsfeld/${f.slug}/`} class={aktivFeld === f.slug ? 'an' : ''}>{f.name}<small>{f.n}</small></a>)}
    </div>
  </div>
</div>

<!-- LISTE -->
<div class="st-main">
  <div class="st-container">
    {einleitung && <p class="st-intro">{einleitung}</p>}

    <div class="st-cta">
      <div>
        <p style="font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#3b82f6;margin-bottom:6px">Für Arbeitgeber</p>
        <p><strong>Sie möchten eine Stelle ausschreiben?</strong><br>Stellen veröffentlichen, mit dem Personal-Cockpit gegen den Markt vergleichen, als Arbeitgeber sichtbar werden – im Arbeitgeberservice.</p>
      </div>
      <a href="/arbeitgeberservice/" class="st-cta-btn">Zum Arbeitgeberservice →</a>
    </div>

    <div class="st-count" id="stCount">{gesamt} {gesamt === 1 ? 'Stelle' : 'Stellen'}{seiten > 1 ? ` · Seite ${seite} von ${seiten}` : ''}</div>

    <div id="jobList">
      {liste.length === 0 ? (
        <div class="st-empty">
          <div style="font-size:40px;margin-bottom:16px">📋</div>
          <h3>Aktuell keine offenen Stellen in dieser Auswahl</h3>
          <p>Neue Anzeigen erscheinen täglich – alle Stellen stehen in der <a href="/stellen/">Übersicht</a>.</p>
        </div>
      ) : liste.map((job) => (
        <a class={job.cardClass} href={'/stellen/' + job.id + '/'} data-stelle={job.id} data-arbeitgeber={job.data.organisation}>
          <div class="st-card-inner">
            <div>
              {job.paketLower !== 'basis' && <div class={job.badgeClass}>{job.data.paket}</div>}
              <div class="st-card-org">{job.data.organisation} · {job.data.orgtyp}</div>
              <div class="st-card-title">{job.data.title}</div>
              <div class="st-card-meta">
                <span class="st-card-meta-item">{job.data.ort}, {job.data.bundesland}</span>
                <span class="st-card-meta-item">{job.data.beschaeftigung}</span>
                <span class="st-card-meta-item">{job.data.entgelt}</span>
                <span class="st-card-meta-item">{job.data.befristung}</span>
              </div>
              {job.data.schlagwoerter && (
                <div class="st-tags">{job.data.schlagwoerter.slice(0, 4).map((tag) => <span class="st-tag">{tag}</span>)}</div>
              )}
            </div>
            <div class="st-card-right">
              <div class={job.deadlineClass}>{job.deadlineTxt}</div>
              <span class="st-card-btn">Zur Stelle →</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    {seiten > 1 && (
      <nav class="st-seiten" id="stSeiten" aria-label="Seiten">
        {seite > 1 && <a href={seitenUrl(seite - 1)} rel="prev">← Zurück</a>}
        {Array.from({ length: seiten }, (_, i) => i + 1).map((n) => n === seite ? <span class="an">{n}</span> : <a href={seitenUrl(n)}>{n}</a>)}
        {seite < seiten && <a href={seitenUrl(seite + 1)} rel="next">Weiter →</a>}
      </nav>
    )}

    <JobAlert land={laender.find((l) => l.slug === aktivLand)?.name || ''} feld={aktivFeld || ''}
      titel={`Job-Alert${aktivFeld ? ': ' + (felder.find((f) => f.slug === aktivFeld)?.name || '') : ''}${aktivLand ? ' in ' + (laender.find((l) => l.slug === aktivLand)?.name || '') : ''} – neue Stellen per Mail`} />

    <div class="st-cta">
      <p><strong>Ihre Stelle noch nicht dabei?</strong><br>Mit der KommunalFlat sind alle Ihre Ausschreibungen sofort online – inklusive Personal-Cockpit und Arbeitgeberprofil.</p>
      <a href="/arbeitgeberservice/" class="st-cta-btn">Arbeitgeberservice →</a>
    </div>
  </div>
</div>

<script is:inline>
(() => {
  const f = document.getElementById('stSuche'); if (!f) return;
  const $ = (id) => document.getElementById(id);
  const liste = $('jobList'), zaehler = $('stCount'), seiten = $('stSeiten'), info = $('stInfo'), reset = $('stReset');
  const ursprung = liste.innerHTML, ursprungZahl = zaehler ? zaehler.textContent : '';
  let index = null, timer = null;
  const norm = (t) => (t || '').toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss').replace(/[*:\/()·,.-]+/g, ' ');
  const esc = (t) => String(t || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const eg = (e) => { const m = /(?:\b(?:EG|E|A|TV[ -]?L?|TV[oö]D)\s*)(\d{1,2})\b/i.exec(e || ''); return m ? +m[1] : null; };
  const frist = (d) => { const t = Math.ceil((new Date(d) - Date.now()) / 864e5); if (t <= 0) return ['Heute!', 1]; if (t === 1) return ['Noch 1 Tag', 1]; if (t < 8) return ['Noch ' + t + ' Tage', 1]; return ['bis ' + new Date(d).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' }), 0]; };
  const karte = (s) => { const [ft, dr] = frist(s.fr); return '<a class="st-card' + (s.p !== 'basis' ? ' ' + s.p : '') + '" href="/stellen/' + s.id + '/"><div class="st-card-inner"><div>' +
    (s.p !== 'basis' ? '<div class="st-card-badge ' + s.p + '">' + esc(s.pk) + '</div>' : '') +
    '<div class="st-card-org">' + esc(s.o) + (s.ot ? ' · ' + esc(s.ot) : '') + '</div><div class="st-card-title">' + esc(s.t) + '</div>' +
    '<div class="st-card-meta"><span class="st-card-meta-item">' + esc(s.ort) + ', ' + esc(s.land) + '</span><span class="st-card-meta-item">' + esc(s.b) + '</span><span class="st-card-meta-item">' + esc(s.e) + '</span><span class="st-card-meta-item">' + esc(s.bf) + '</span></div>' +
    (s.sw && s.sw.length ? '<div class="st-tags">' + s.sw.slice(0, 4).map((t) => '<span class="st-tag">' + esc(t) + '</span>').join('') + '</div>' : '') +
    '</div><div class="st-card-right"><div class="st-card-deadline' + (dr ? ' urgent' : '') + '">' + ft + '</div><span class="st-card-btn">Zur Stelle →</span></div></div></a>'; };
  const werte = () => ({ q: $('stQ').value.trim(), land: $('stLand').value, feld: $('stFeld').value, eg: $('stEg').value, unbef: $('stUnbef').checked, tz: $('stTz').checked });
  const vorbelegt = { land: $('stLand').value, feld: $('stFeld').value };
  const aktiv = (w) => w.q || w.eg || w.unbef || w.tz || w.land !== vorbelegt.land || w.feld !== vorbelegt.feld;
  const url = (w) => { const p = new URLSearchParams(); if (w.q) p.set('q', w.q); if (w.land) p.set('land', w.land); if (w.feld) p.set('feld', w.feld); if (w.eg) p.set('eg', w.eg); if (w.unbef) p.set('unbefristet', '1'); if (w.tz) p.set('teilzeit', '1'); const s = p.toString(); history.replaceState(null, '', location.pathname + (s ? '?' + s : '')); };
  async function laden() { if (!index) index = await (await fetch('/stellen/suche.json')).json(); return index; }
  async function suchen() {
    const w = werte();
    if (!aktiv(w)) { liste.innerHTML = ursprung; if (zaehler) zaehler.textContent = ursprungZahl; if (seiten) seiten.hidden = false; info.textContent = ''; reset.hidden = true; url({ ...w, land: '', feld: '' }); return; }
    const daten = await laden();
    const woerter = norm(w.q).split(/\s+/).filter(Boolean);
    const treffer = daten.filter((s) => {
      if (w.land && s.ls !== w.land) return false;
      if (w.feld && s.f !== w.feld) return false;
      if (w.eg) { const n = eg(s.e); if (n === null || n < +w.eg) return false; }
      if (w.unbef && !/unbefristet/i.test(s.bf)) return false;
      if (w.tz && !/teilzeit/i.test(s.b)) return false;
      if (!woerter.length) return true;
      const heu = norm([s.t, s.o, s.ot, s.ort, s.plz, s.land, s.e, (s.sw || []).join(' ')].join(' '));
      return woerter.every((x) => heu.includes(x));
    });
    liste.innerHTML = treffer.length ? treffer.slice(0, 200).map(karte).join('') :
      '<div class="st-empty"><h3>Keine passende Stelle gefunden</h3><p>Probieren Sie einen allgemeineren Begriff oder entfernen Sie einen Filter. Neue Anzeigen erscheinen täglich.</p></div>';
    if (zaehler) zaehler.textContent = treffer.length + (treffer.length === 1 ? ' Treffer' : ' Treffer') + (treffer.length > 200 ? ' · die ersten 200 angezeigt' : '');
    if (seiten) seiten.hidden = true;
    info.textContent = treffer.length + ' von ' + daten.length + ' Stellen';
    reset.hidden = false; url(w);
  }
  f.addEventListener('submit', (e) => { e.preventDefault(); suchen(); });
  f.addEventListener('change', suchen);
  $('stUnbef').addEventListener('change', suchen); $('stTz').addEventListener('change', suchen);
  $('stQ').addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(suchen, 250); });
  reset.addEventListener('click', () => { $('stQ').value = ''; $('stEg').value = ''; $('stUnbef').checked = false; $('stTz').checked = false; $('stLand').value = vorbelegt.land; $('stFeld').value = vorbelegt.feld; suchen(); });
  const p = new URLSearchParams(location.search);
  if ([...p.keys()].length) {
    if (p.get('q')) $('stQ').value = p.get('q'); if (p.get('land')) $('stLand').value = p.get('land'); if (p.get('feld')) $('stFeld').value = p.get('feld');
    if (p.get('eg')) $('stEg').value = p.get('eg'); $('stUnbef').checked = p.has('unbefristet'); $('stTz').checked = p.has('teilzeit');
    suchen();
  }
})();
</script>

