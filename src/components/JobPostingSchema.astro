---
interface Props {
  title: string;
  description: string;
  datePosted: string;
  validThrough: string;
  employerName: string;
  jobLocation: string;
  jobRegion?: string;
  strasse?: string;
  plz?: string;
  employmentType?: string;
  entgelt?: string;
  applicationUrl?: string;
  identifier?: string;
  gehalt?: { min: number; max: number } | null;
}

const {
  title,
  description,
  datePosted,
  validThrough,
  employerName,
  jobLocation,
  jobRegion = 'Deutschland',
  strasse,
  plz,
  employmentType = 'FULL_TIME',
  entgelt,
  applicationUrl,
  identifier,
  gehalt,
} = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title,
  description,
  datePosted,
  validThrough,
  employmentType,
  // Bewerbung läuft über das Portal des Arbeitgebers, nicht über derkaemmerer.de
  directApply: false,
  hiringOrganization: {
    '@type': 'Organization',
    name: employerName,
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      ...(strasse && { streetAddress: strasse }),
      ...(plz && { postalCode: plz }),
      addressLocality: jobLocation,
      addressRegion: jobRegion,
      addressCountry: 'DE',
    },
  },
  ...(entgelt && {
    jobBenefits: entgelt,
  }),
  // Monatliche Spanne Stufe 1–6 laut TVöD-VKA-Tabelle (nur bei eindeutiger Entgeltgruppe)
  ...(gehalt && {
    baseSalary: {
      '@type': 'MonetaryAmount',
      currency: 'EUR',
      value: { '@type': 'QuantitativeValue', minValue: gehalt.min, maxValue: gehalt.max, unitText: 'MONTH' },
    },
  }),
  ...(applicationUrl && !applicationUrl.includes('trefferliste') && {
    applicationContact: {
      '@type': 'ContactPoint',
      url: applicationUrl,
    },
  }),
  ...(identifier && {
    identifier: {
      '@type': 'PropertyValue',
      name: employerName,
      value: identifier,
    },
  }),
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
