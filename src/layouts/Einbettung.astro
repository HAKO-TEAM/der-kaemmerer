---
// Schlanke Hülle für einbettbare Grafiken (iframe auf fremden Seiten): ohne Kopf, Fuß und Tracking, nicht indexiert,
// kanonisch auf die Vollansicht bei Der Kämmerer.
interface Props { title: string; kanonisch: string }
const { title, kanonisch } = Astro.props;
---
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title} — Der Kämmerer</title>
<meta name="robots" content="noindex, follow">
<link rel="canonical" href={kanonisch}>
<base target="_blank">
<style is:global>
  * { box-sizing:border-box; }
  html, body { margin:0; background:transparent; }
  body { font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; color:#0f172a; -webkit-font-smoothing:antialiased; }
  .eb { background:#fff; border:1px solid #e2e8f0; border-radius:14px; overflow:hidden; }
  .eb-kopf { display:flex; justify-content:space-between; align-items:center; gap:10px; padding:12px 16px; background:#172840; color:#fff; }
  .eb-kopf h1 { margin:0; font:700 16px/1.25 Georgia, 'Times New Roman', serif; letter-spacing:.005em; }
  .eb-kopf small { display:block; font:500 11px/1.3 inherit; color:#93c5fd; letter-spacing:.06em; text-transform:uppercase; margin-bottom:2px; }
  .eb-marke { font:800 13px/1 Arial, sans-serif; color:#fff; text-decoration:none; white-space:nowrap; } .eb-marke span { color:#60a5fa; }
  .eb-fuss { display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap; padding:9px 16px; border-top:1px solid #f1f5f9; font-size:11px; color:#64748b; }
  .eb-fuss a { color:#2563eb; text-decoration:none; font-weight:600; }
</style>
</head>
<body>
<slot />
<script is:inline>
  // Höhe an die einbettende Seite melden (optionales Snippet dort passt das iframe an)
  (function () {
    var melde = function () { try { parent.postMessage({ dkHoehe: document.documentElement.scrollHeight }, '*'); } catch (e) {} };
    addEventListener('load', melde); addEventListener('resize', melde); setTimeout(melde, 300);
  })();
</script>
</body>
</html>
